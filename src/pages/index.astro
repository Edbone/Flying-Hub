---
import Analytics from "@vercel/analytics/astro";
---

<html lang="en">
  <head>
    <title>Eddie Jackson</title>
    <meta
      name="description"
      content="Aviation portfolio, training notes, flight instruction resources, and flying photography by Eddie Jackson."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>

  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href="/" aria-label="EKAviates home">
          <img src="/ekwx-logo.png" alt="EKAviates logo" />
        </a>

        <div class="nav-links">
          <a href="/" aria-current="page">Home</a>
          <a href="/photos">Photos</a>
          <a href="/portfolio">Portfolio</a>
          <a href="https://publish.obsidian.md/ekaviates/EKAviates">Notes</a>
          <a href="https://wx.ekaviates.com/">Radar & Traffic</a>
          <details class="nav-dropdown">
            <summary>Student Tools</summary>
            <div class="dropdown-menu">
              <a href="/flight-instruction#crosswind-tool">Crosswind</a>
              <a href="/flight-instruction#weight-balance-tool">Weight & Balance</a>
              <a href="/flight-instruction#density-altitude-tool">Density Altitude</a>
              <a href="https://scaniverse.com/scan/idwyj4cfuuj6r3ou" target="_blank" rel="noreferrer">3D Model IO 360</a>
            </div>
          </details>
          <a href="/flight-line">Flight Line</a>
          <a href="/contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="feature-grid" aria-label="Featured aviation resources">
        <a class="feature-card" href="/portfolio">
          <strong>Aviation Coding Portfolio</strong>
          <span>Embedded aviation projects built over the last three years.</span>
        </a>

        <a class="feature-card" href="https://publish.obsidian.md/ekaviates/EKAviates">
          <strong>Training Vault</strong>
          <span>Notes and study references from training.</span>
        </a>

        <a class="feature-card" href="https://wx.ekaviates.com/">
          <strong>Radar & Traffic</strong>
          <span>Weather radar and nearby traffic in one place.</span>
        </a>

        <a class="feature-card" href="/flight-instruction">
          <strong>Student Tools</strong>
          <span>Crosswind, weight and balance, density altitude, and the IO-360 3D model.</span>
        </a>

        <a class="feature-card" href="/photos">
          <strong>Aviation Photo Library</strong>
          <span>Aircraft, training moments, and flying milestones from the collection.</span>
        </a>
      </section>

      <div class="iframe-pair">
        <section class="notes-preview" aria-labelledby="notes-preview-heading">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Reference library</p>
              <h2 id="notes-preview-heading">Aviation Notes</h2>
            </div>
          </div>

          <div class="notes-frame">
            <iframe
              src="https://publish.obsidian.md/ekaviates/EKAviates"
              title="EKAviates aviation notes"
              loading="lazy"
            ></iframe>
          </div>
        </section>

        <section class="radar-preview" aria-labelledby="radar-preview-heading">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Radar & Traffic</p>
              <h2 id="radar-preview-heading">Live Tracker</h2>
            </div>
          </div>

          <div class="radar-frame">
            <iframe
              src="https://wx.ekaviates.com/"
              title="EKAviates weather radar and traffic tracker"
              loading="lazy"
              allowfullscreen
            ></iframe>
            <a
              class="tracker-link"
              href="https://wx.ekaviates.com/"
              aria-label="Open the live tracker website"
            ></a>
          </div>
        </section>
      </div>
    </main>

    <Analytics />
  </body>
</html>

<style>
:root {
  --bg: #f7fbff;
  --paper: rgba(255, 255, 255, 0.9);
  --text: #18324d;
  --muted: #5d7084;
  --line: rgba(29, 95, 145, 0.16);

  --blue: #1e73be;
  --blue-dark: #103d67;
  --teal: #167c8c;
  --gold: #b9812b;
  --sky: #8fc7f5;

  --ink: #07111f;
  --shadow: 0 24px 70px rgba(26, 62, 96, 0.14);
}

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    background-color: var(--bg);
    scroll-behavior: smooth;
  }

body {
  margin: 0;
  min-height: 100vh;
  min-height: 100dvh;
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;
  color: var(--text);
  background-color: var(--bg);
  background:
    linear-gradient(180deg, rgba(247, 251, 255, 0.82) 0%, rgba(247, 251, 255, 0.96) 58%),
    linear-gradient(135deg, rgba(30, 115, 190, 0.12), rgba(22, 124, 140, 0.08) 38%, rgba(185, 129, 43, 0.08)),
    url("/topobackground.png");
  background-attachment: fixed;
  background-position: center;
  background-size: cover;
  background-color: var(--bg);
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(to bottom, rgba(143, 199, 245, 0.12), transparent 42%);
  mask-image: linear-gradient(to bottom, black, transparent 82%);
}

  @media (max-width: 1180px), (hover: none) {
    body {
      background-attachment: scroll;
      background-position: center top;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(16px);
  }

  .nav {
    max-width: 1360px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: auto;
    height: clamp(56px, 5vw, 78px);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .nav-links a,
  .nav-dropdown summary {
    position: relative;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    list-style: none;
    transition: color 180ms ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"],
  .nav-dropdown summary[aria-current="page"],
  .nav-dropdown summary:hover {
    color: var(--blue);
  }

  .nav-links > a[aria-current="page"]::after,
  .nav-dropdown summary[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -9px;
    height: 2px;
    border-radius: 999px;
    background: #00d9ff;
    box-shadow:
      0 0 8px rgba(0, 217, 255, 0.95),
      0 0 18px rgba(0, 217, 255, 0.8),
      0 0 32px rgba(0, 217, 255, 0.42);
    transform-origin: left;
    animation: navGlowIn 650ms ease-out both;
  }

  @keyframes navGlowIn {
    from {
      opacity: 0;
      transform: scaleX(0);
    }

    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown summary {
    cursor: pointer;
  }

  .nav-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    z-index: 30;
    min-width: 220px;
    padding: 8px;
    display: grid;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: var(--shadow);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -4px);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .nav-dropdown[open] .dropdown-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .dropdown-menu a {
    padding: 10px 12px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .dropdown-menu a:hover {
    background: rgba(30, 115, 190, 0.08);
    color: var(--text);
  }

  .nav {
    padding: 12px 24px;
    gap: 18px;
  }

  .brand img {
    height: clamp(48px, 4.5vw, 68px);
  }

  .nav-links {
    justify-content: flex-end;
    gap: 12px 18px;
  }

  .nav-links a,
  .nav-dropdown summary {
    font-size: 0.86rem;
    white-space: nowrap;
  }

  @media (max-width: 980px) {
    .nav {
      padding: 12px 18px;
      gap: 16px;
    }

    .brand img {
      height: 52px;
    }

    .nav-links {
      justify-content: flex-end;
      gap: 12px 16px;
    }

    .nav-links a,
    .nav-dropdown summary {
      font-size: 0.86rem;
    }
  }

  main {
    position: relative;
    width: 100%;
    padding: 48px clamp(24px, 3vw, 56px) 88px;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: var(--blue);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .feature-grid {
    margin-top: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
  }

  .feature-card {
    min-height: 172px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    text-align: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.84);
    color: var(--text);
    text-decoration: none;
    box-shadow: 0 18px 44px rgba(26, 62, 96, 0.1);
    backdrop-filter: blur(16px);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .feature-card:hover {
    border-color: rgba(22, 124, 140, 0.38);
    box-shadow: 0 22px 52px rgba(26, 62, 96, 0.16);
    transform: translateY(-2px);
  }

  .feature-card strong {
    color: inherit;
    font-size: clamp(1.28rem, 2vw, 1.72rem);
    line-height: 1;
  }

  .feature-card span:last-child {
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .iframe-pair {
    margin-top: 46px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .section-heading {
    margin-bottom: 24px;
    min-height: 82px;
    padding-bottom: 16px;
    display: flex;
    align-items: end;
    justify-content: center;
    text-align: center;
    gap: 24px;
  }

  .section-heading .eyebrow {
    margin-bottom: 12px;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.65rem, 3vw, 2.6rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .radar-frame,
  .notes-frame {
    position: relative;
    overflow: hidden;
    height: clamp(520px, 68vh, 680px);
    border-radius: 22px;
    border: 1px solid var(--line);
    background: var(--paper);
    box-shadow: var(--shadow);
    backdrop-filter: blur(18px);
  }

  .radar-frame iframe,
  .notes-frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #f3f8fd;
  }

  .tracker-link {
    position: absolute;
    inset: 0;
    z-index: 2;
    cursor: pointer;
  }

  @media (max-width: 1100px) {
    main {
      padding-top: 34px;
    }

    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .iframe-pair {
      margin-top: 32px;
    }

    .radar-frame,
    .notes-frame {
      height: 620px;
    }
  }

  @media (max-width: 680px) {
    .nav {
      align-items: center;
      flex-direction: column;
      gap: 12px;
      padding: 10px 16px 12px;
    }

    .brand img {
      height: 52px;
    }

    .nav-links {
      position: relative;
      width: 100%;
      gap: 8px 14px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-links a,
    .nav-dropdown summary {
      font-size: 0.84rem;
    }

    .nav-dropdown {
      position: static;
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 10px);
      left: 50%;
      min-width: min(220px, 100%);
      width: min(100%, 320px);
      margin-top: 0;
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, -4px);
    }

    .nav-dropdown[open] .dropdown-menu {
      opacity: 1;
      pointer-events: auto;
      transform: translate(-50%, 0);
    }

    main {
      padding-inline: 18px;
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }

    .feature-card {
      min-height: 142px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .iframe-pair {
      grid-template-columns: 1fr;
    }

    .radar-frame,
    .notes-frame {
      height: 560px;
    }

  }
</style>
