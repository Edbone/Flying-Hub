---
const cloudName = "dnjzeouq5";

let images = [];

try {
  const res = await fetch(
    `https://res.cloudinary.com/${cloudName}/image/list/aviation.json`
  );
  const data = await res.json();

  images = (data.resources ?? []).sort((a, b) => b.version - a.version);
} catch (e) {
  images = [];
}
---

<html lang="en">
  <head>
    <title>Eddie Jackson Aviation</title>
    <meta
      name="description"
      content="Aviation portfolio, training notes, flight instruction resources, and flying photography by Eddie Jackson."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href="/">EKAviates</a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/photos">Photos</a>
          <a href="https://publish.obsidian.md/ekaviates/Pilot+Hub/Pilot+Hub">Notes</a>
          <a href="/flight-instruction">Instruction</a>
          <a href="/contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Eddie Jackson</p>

          <h1>My Flying Life</h1>

          <p class="intro">

          </p>

          <div class="buttons">
            <a class="button primary" href="/photos">View Photos</a>
            <a class="button secondary" href="https://publish.obsidian.md/ekaviates/Pilot+Hub/Pilot+Hub">
              Aviation Notes
            </a>
          </div>
        </div>

        <div class="photo-panel">
          {images.length > 0 ? (
            images.slice(0, 35).map((img, index) => (
              <img
                class={index === 0 ? "active" : ""}
                src={`https://res.cloudinary.com/${cloudName}/image/upload/f_auto,q_auto,w_1000/${img.public_id}.${img.format}`}
                alt={img.public_id}
                loading={index === 0 ? "eager" : "lazy"}
              />
            ))
          ) : (
            <div class="photo-fallback">
              <span>No photos loaded</span>
            </div>
          )}

          <div class="photo-caption">
            <span></span>
            <strong></strong>
          </div>
        </div>
      </section>

      <section class="feature-grid" aria-label="Site sections">
        <a class="feature-card" href="/photos">
          <span class="feature-number"></span>
          <h2>Flying Career</h2>
          <p>Photos, aircraft, trips, and milestones from training.</p>
        </a>

        <a class="feature-card" href="https://publish.obsidian.md/edbonesnotes">
          <span class="feature-number"></span>
          <h2>Aviation Notes</h2>
          <p>CFI, instrument, commercial, systems, and checkride prep notes.</p>
        </a>

        <a class="feature-card" href="/flight-instruction">
          <span class="feature-number"></span>
          <h2>Instruction</h2>
          <p>Ground instruction, lesson planning, and student resources.</p>
        </a>
      </section>
    </main>

    <script>
      const photos = document.querySelectorAll(".photo-panel img");
      let current = 0;

      if (photos.length > 1) {
        setInterval(() => {
          photos[current].classList.remove("active");
          current = (current + 1) % photos.length;
          photos[current].classList.add("active");
        }, 4200);
      }
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #e7edf3;
    --bg-dark: #1f2d3a;
    --text: #101820;
    --muted: #5e6b76;
    --blue: #2f7cc4;
    --blue-dark: #155b98;
    --yellow: #000000;
    --card: #ffffff;
    --line: rgba(16, 24, 32, 0.12);
    --shadow: 0 18px 45px rgba(20, 35, 50, 0.16);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: var(--text);
    background:
      radial-gradient(circle at top left, rgba(47, 124, 196, 0.22), transparent 34rem),
      linear-gradient(135deg, #eef3f7 0%, #d5e1eb 45%, #8aa8c4 100%);
    min-height: 100vh;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(231, 237, 243, 0.9);
    border-bottom: 1px solid var(--line);
  }

  .nav {
    max-width: 1120px;
    margin: 0 auto;
    padding: 18px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    color: var(--text);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .nav-links a {
    color: var(--muted);
    font-size: 0.94rem;
    font-weight: 650;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .nav-links a:hover {
    color: var(--blue-dark);
  }

  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 72px 22px 90px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(360px, 0.96fr);
    gap: 52px;
    align-items: center;
  }

  .hero-copy {
    max-width: 620px;
  }

  .eyebrow {
    width: fit-content;
    margin: 0 0 18px;
    padding: 8px 12px;
    border-left: 4px solid var(--yellow);
    background: rgba(255, 255, 255, 0.62);
    color: var(--blue-dark);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0;
    max-width: 760px;
    color: #101820;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.075em;
  }

  .intro {
    max-width: 560px;
    margin: 26px 0 0;
    color: #344555;
    font-size: clamp(1.05rem, 1.7vw, 1.22rem);
    line-height: 1.65;
  }

  .buttons {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button.primary {
    background: var(--blue-dark);
    color: white;
    box-shadow: 0 12px 26px rgba(21, 91, 152, 0.28);
  }

  .button.primary:hover {
    background: #0f4c82;
  }

  .button.secondary {
    background: white;
    color: var(--text);
    border: 1px solid var(--line);
  }

  .button.secondary:hover {
    color: var(--blue-dark);
    box-shadow: 0 12px 26px rgba(20, 35, 50, 0.1);
  }

  .photo-panel {
    position: relative;
    min-height: 560px;
    overflow: hidden;
    border-radius: 22px;
    background: #213140;
    box-shadow: var(--shadow);
  }

  .photo-panel::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(8, 14, 22, 0.72), transparent 46%),
      linear-gradient(to right, rgba(8, 14, 22, 0.18), transparent 40%);
    pointer-events: none;
  }

  .photo-panel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.035);
    transition:
      opacity 900ms ease,
      transform 5200ms ease;
  }

  .photo-panel img.active {
    opacity: 1;
    transform: scale(1);
  }

  .photo-caption {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 24px;
    z-index: 2;
    padding-top: 18px;
    color: white;
  }

  .photo-caption span {
    display: block;
    margin-bottom: 6px;
    color: var(--yellow);
    font-size: 0.74rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .photo-caption strong {
    display: block;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .photo-fallback {
    min-height: 560px;
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 700;
  }

  .feature-grid {
    margin-top: 76px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

.feature-card {
  position: relative;
  min-height: 220px;
  padding: 28px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  overflow: hidden;
  border-radius: 18px;
  border: 1px solid var(--line);
  background: var(--card);
  color: var(--text);
  text-decoration: none;
  box-shadow: 0 12px 30px rgba(20, 35, 50, 0.08);
  transition:
    transform 180ms ease,
    box-shadow 180ms ease,
    border-color 180ms ease;
}

.feature-card::before {
  display: none;
}

  .feature-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 28px;
    width: 52px;
    height: 5px;
    background: var(--blue);
    border-radius: 999px;
  }

  .feature-card:hover {
    transform: translateY(-5px);
    border-color: rgba(47, 124, 196, 0.35);
    box-shadow: 0 22px 42px rgba(20, 35, 50, 0.14);
  }

  .feature-number {
    position: absolute;
    top: 24px;
    right: 26px;
    color: rgba(16, 24, 32, 0.22);
    font-size: 0.85rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .feature-card h2 {
    margin: 0 0 10px;
    font-size: 1.35rem;
    letter-spacing: -0.035em;
  }

  .feature-card p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    main {
      padding-top: 48px;
    }

    .hero {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .photo-panel,
    .photo-fallback {
      min-height: 440px;
    }

    .feature-grid {
      grid-template-columns: 1fr;
      margin-top: 48px;
    }
  }

  @media (max-width: 680px) {
    .nav {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .nav-links {
      width: 100%;
      gap: 10px 16px;
      flex-wrap: wrap;
    }

    .hero {
      gap: 32px;
    }

    h1 {
      font-size: clamp(3rem, 17vw, 4.6rem);
    }

    .buttons {
      flex-direction: column;
    }

    .button {
      width: 100%;
    }

    .photo-panel,
    .photo-fallback {
      min-height: 390px;
      border-radius: 18px;
    }

    .feature-card {
      min-height: 190px;
    }
  }
</style>