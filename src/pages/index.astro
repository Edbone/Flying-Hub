---
import Analytics from "@vercel/analytics/astro";

const cloudName = "dnjzeouq5";

let images = [];

try {
  const res = await fetch(
    `https://res.cloudinary.com/${cloudName}/image/list/aviation.json`
  );
  const data = await res.json();

  images = (data.resources ?? []).sort((a, b) => b.version - a.version);
} catch (e) {
  images = [];
}
---

<html lang="en">
  <head>
    <title>Eddie Jackson</title>
    <meta
      name="description"
      content="Aviation portfolio, training notes, flight instruction resources, and flying photography by Eddie Jackson."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>

  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href="/">EKAviates</a>

        <div class="nav-links">
          <a href="/" aria-current="page">Home</a>
          <a href="/photos">Photos</a>
          <a href="https://publish.obsidian.md/ekaviates/Pilot+Hub/EKAviates">Notes</a>
          <details class="nav-dropdown">
            <summary>Instruction</summary>
            <div class="dropdown-menu">
              <a href="/flight-instruction#crosswind-tool">Crosswind</a>
              <a href="/flight-instruction#weight-balance-tool">Weight & Balance</a>
              <a href="/flight-instruction#density-altitude-tool">Density Altitude</a>
            </div>
          </details>
          <a href="/flight-line">Flight Line</a>
          <a href="/contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Eddie Jackson</p>

          <h1>Flight training, notes, and photos.</h1>

          <p class="intro">
            
          </p>

   

          <div class="course-strip" aria-label="Course areas">
            <span>Private</span>
            <span>Instrument</span>
            <span>Commercial</span>
          </div>
        </div>

        <div class="photo-panel">
          {images.length > 0 ? (
            images.slice(0, 35).map((img, index) => (
              <img
                class={index === 0 ? "active" : ""}
                src={`https://res.cloudinary.com/${cloudName}/image/upload/f_auto,q_auto,w_1200/${img.public_id}.${img.format}`}
                alt={img.public_id}
                loading={index === 0 ? "eager" : "lazy"}
              />
            ))
          ) : (
            <div class="photo-fallback">
              <span>No photos loaded</span>
            </div>
          )}
        </div>
      </section>

      <section class="notes-preview" aria-labelledby="notes-preview-heading">
        <div class="section-heading">

            <p class="eyebrow"></p>
            <h2 id="notes-preview-heading">Aviation Notes</h2>
          </div>
        </div>

        <div class="notes-frame">
          <iframe
            src="https://publish.obsidian.md/ekaviates/Pilot+Hub/EKAviates"
            title="EKAviates aviation notes"
            loading="lazy"
          ></iframe>
        </div>
      </section>
    </main>

    <Analytics />

    <script>
      const photos = document.querySelectorAll(".photo-panel img");
      let current = 0;

      if (photos.length > 1) {
        setInterval(() => {
          photos[current].classList.remove("active");
          current = (current + 1) % photos.length;
          photos[current].classList.add("active");
        }, 4200);
      }
    </script>
  </body>
</html>

<style>
:root {
  --bg: #05080d;
  --paper: rgba(9, 16, 25, 0.84);
  --text: #eef6ff;
  --muted: #a8b8c8;
  --line: rgba(238, 246, 255, 0.14);

  --blue: #1e73be;
  --blue-dark: #0b3f73;
  --blue-soft: #d9ebfa;
  --sky: #8fc7f5;

  --ink: #f7fbff;
  --shadow: 0 24px 70px rgba(0, 0, 0, 0.38);
}

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    background-color: var(--bg);
    scroll-behavior: smooth;
  }

body {
  margin: 0;
  min-height: 100vh;
  min-height: 100dvh;
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;
  color: var(--text);
  background-color: var(--bg);
  background:
    radial-gradient(circle at 18% 8%, rgba(30, 115, 190, 0.34), transparent 30rem),
    linear-gradient(135deg, rgba(5, 8, 13, 0.78) 0%, rgba(7, 15, 26, 0.82) 48%, rgba(3, 7, 12, 0.9) 100%),
    url("/topobackground.png");
  background-attachment: fixed;
  background-position: center;
  background-size: cover;
  background-color: var(--bg);
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(to bottom, rgba(143, 199, 245, 0.08), transparent 42%);
  mask-image: linear-gradient(to bottom, black, transparent 82%);
}

  @media (max-width: 1180px), (hover: none) {
    body {
      background-attachment: scroll;
      background-position: center top;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(5, 8, 13, 0.86);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(16px);
  }

  .nav {
    max-width: 1360px;
    margin: 0 auto;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    color: var(--text);
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-links a,
  .nav-dropdown summary {
    position: relative;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    list-style: none;
    transition: color 180ms ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"],
  .nav-dropdown summary[aria-current="page"],
  .nav-dropdown summary:hover {
    color: var(--blue);
  }

  .nav-links > a[aria-current="page"]::after,
  .nav-dropdown summary[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -9px;
    height: 2px;
    border-radius: 999px;
    background: #00d9ff;
    box-shadow:
      0 0 8px rgba(0, 217, 255, 0.95),
      0 0 18px rgba(0, 217, 255, 0.8),
      0 0 32px rgba(0, 217, 255, 0.42);
    transform-origin: left;
    animation: navGlowIn 650ms ease-out both;
  }

  @keyframes navGlowIn {
    from {
      opacity: 0;
      transform: scaleX(0);
    }

    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown summary {
    cursor: pointer;
  }

  .nav-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    z-index: 30;
    min-width: 220px;
    padding: 8px;
    display: grid;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(5, 8, 13, 0.96);
    box-shadow: var(--shadow);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -4px);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .nav-dropdown[open] .dropdown-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .dropdown-menu a {
    padding: 10px 12px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .dropdown-menu a:hover {
    background: rgba(255, 255, 255, 0.07);
    color: var(--text);
  }

  main {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    padding: 68px 24px 88px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(380px, 1.1fr);
    gap: 56px;
    align-items: center;
  }

  .hero-copy {
    max-width: 630px;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: var(--blue);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

h1 {
  margin: 0;
  color: var(--ink);
  font-size: clamp(3.4rem, 7.5vw, 6.8rem);
  line-height: 0.95;
  letter-spacing: -0.045em;
}

  .intro {
    max-width: 540px;
    margin: 26px 0 0;
    color: #c7d5e2;
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    line-height: 1.65;
  }

  .buttons {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 999px;
    font-size: 0.94rem;
    font-weight: 850;
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button.primary {
    background: #eef6ff;
    color: #07111f;
    box-shadow: 0 16px 32px rgba(11, 17, 23, 0.22);
  }

  .button.primary:hover {
    background: var(--blue-dark);
  }

  .button.secondary {
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink);
    border: 1px solid var(--line);
  }

  .button.secondary:hover {
    border-color: rgba(20, 94, 168, 0.38);
    color: var(--blue);
  }

  .course-strip {
    margin-top: 42px;
    padding-top: 22px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    border-top: 1px solid var(--line);
  }

  .course-strip span {
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    color: #d6e4f0;
    font-size: 0.78rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .photo-panel {
    position: relative;
    min-height: 620px;
    overflow: hidden;
    border-radius: 28px;
    background: #17212b;
    box-shadow: var(--shadow);
  }

  .photo-panel::before {
    content: "";
    position: absolute;
    inset: 14px;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 20px;
    pointer-events: none;
  }

  .photo-panel::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to top, rgba(5, 10, 16, 0.35), transparent 45%),
      linear-gradient(to right, rgba(5, 10, 16, 0.12), transparent 42%);
    pointer-events: none;
  }

  .photo-panel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.035);
    transition:
      opacity 900ms ease,
      transform 5200ms ease;
  }

  .photo-panel img.active {
    opacity: 1;
    transform: scale(1);
  }

  .photo-fallback {
    min-height: 620px;
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.78);
    font-weight: 800;
  }

  .notes-preview {
    margin-top: 76px;
  }

  .section-heading {
    margin-bottom: 24px;
    padding-bottom: 22px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid var(--line);
  }

  .section-heading .eyebrow {
    margin-bottom: 12px;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.2rem, 5vw, 4.4rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .notes-frame {
    overflow: hidden;
    height: clamp(520px, 68vh, 680px);
    border-radius: 22px;
    border: 1px solid var(--line);
    background: var(--paper);
    box-shadow: var(--shadow);
    backdrop-filter: blur(18px);
  }

  .notes-frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #0b1118;
  }

  @media (max-width: 1100px) {
    main {
      padding-top: 48px;
    }

    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .photo-panel,
    .photo-fallback {
      min-height: 480px;
    }

    .notes-preview {
      margin-top: 48px;
    }

    .notes-frame {
      height: 620px;
    }
  }

  @media (max-width: 680px) {
    .nav {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .nav-links {
      position: relative;
      width: 100%;
      gap: 10px 16px;
      flex-wrap: wrap;
    }

    .nav-dropdown {
      position: static;
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      min-width: min(220px, 100%);
      width: min(100%, 320px);
      margin-top: 0;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-4px);
    }

    .nav-dropdown[open] .dropdown-menu {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    main {
      padding-inline: 18px;
    }

    h1 {
      font-size: clamp(3rem, 16vw, 4.7rem);
    }

    .intro {
      font-size: 1rem;
    }

    .buttons {
      flex-direction: column;
    }

    .button {
      width: 100%;
    }

    .photo-panel,
    .photo-fallback {
      min-height: 390px;
      border-radius: 22px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .section-heading .button {
      width: 100%;
    }

    .notes-frame {
      height: 560px;
    }

  }
</style>
