---
import Analytics from "@vercel/analytics/astro";

const cloudName = "dnjzeouq5";
let latestPhotos = [];

try {
  const response = await fetch(`https://res.cloudinary.com/${cloudName}/image/list/aviation.json`);
  const data = await response.json();
  latestPhotos = (data.resources ?? []).sort((a, b) => b.version - a.version).slice(0, 5);
} catch {
  latestPhotos = [];
}

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7fbff" />
    <title>EKAviates | Eddie Jackson Aviation</title>
    <meta name="description" content="Flight instruction, aviation tools, training notes, projects, and photography by Eddie Jackson." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/site-nav.css" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="EKAviates home">
          <img src="/ekwx-logo.png" alt="" />
          <strong>EKAviates</strong>
        </a>
        <div class="nav-links">
          <a href="/" aria-current="page">Home</a>
          <a href="/photos">Photos</a>
          <a href="/portfolio">Portfolio</a>
          <a href="/notes">Notes</a>
          <a href="https://wx.ekaviates.com/">Radar & Traffic</a>
          <a href="/flight-instruction">Student Tools</a>
          <a class="contact-link" href="/contact">Contact</a>
        </div>
        <details class="mobile-nav">
          <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
          <div class="mobile-menu">
            <a href="/" aria-current="page">Home</a>
            <a href="/photos">Photos</a>
            <a href="/portfolio">Portfolio</a>
            <a href="/notes">Notes</a>
            <a href="https://wx.ekaviates.com/">Radar & Traffic</a>
            <a href="/flight-instruction">Student Tools</a>
            <a href="/contact">Contact</a>
          </div>
        </details>
      </nav>
    </header>

    <main>
      <section class="hero" data-reveal>
        <div class="hero-copy">
          <h1>Flight, made<br /><span>more clear.</span></h1>
          <div class="hero-actions">
            <a class="button primary" href="/flight-instruction">Explore student tools</a>
            <a class="button secondary" href="/photos">View photography</a>
          </div>
          <div class="credentials" aria-label="Credentials">
            <span>CFI / CFII</span><span>Cirrus TCI</span><span>Commercial Multi</span>
          </div>
        </div>
        <div class="hero-flight-image" aria-hidden="true">
          {latestPhotos[0] ? (
            <img
              id="hero-latest-image"
              src={`https://res.cloudinary.com/${cloudName}/image/upload/f_auto,q_auto,w_1400/${latestPhotos[0].public_id}.${latestPhotos[0].format}`}
              alt=""
            />
          ) : (
            <div class="image-fallback"></div>
          )}
        </div>
      </section>

      <section class="photo-feature" aria-labelledby="photo-heading" data-reveal>
        <div class="section-heading">
          <div><p class="eyebrow">From the flight deck</p><h2 id="photo-heading">Aviation, up close.</h2></div>
          <a href="/photos">View the full photo library</a>
        </div>
        {latestPhotos.length > 0 ? (
          <div class="photo-strip" id="home-photo-strip">
            {latestPhotos.map((photo, index) => (
              <a class:list={["home-photo", index === 0 && "lead-photo"]} href="/photos" aria-label="Open aviation photo library">
                <img
                  src={`https://res.cloudinary.com/${cloudName}/image/upload/f_auto,q_auto,w_${index === 0 ? "1600" : "900"}/${photo.public_id}.${photo.format}`}
                  alt={photo.public_id.replaceAll("_", " ")}
                  loading={index === 0 ? "eager" : "lazy"}
                />
              </a>
            ))}
          </div>
        ) : (
          <a class="photo-fallback" href="/photos">Open the aviation photo library</a>
        )}
      </section>

      <section class="radar-section" aria-labelledby="radar-heading" data-reveal>
        <div class="radar-copy">
          <p class="eyebrow">Live radar & traffic</p>
          <h2 id="radar-heading">The whole picture,<br />right now.</h2>
          <p>Current weather radar and nearby aircraft in one focused, pilot-friendly view.</p>
          <a class="button radar-button" href="https://wx.ekaviates.com/">Open full-screen tracker</a>
          <span class="live-status"><i></i> Live data</span>
        </div>
        <a class="radar-window" href="https://wx.ekaviates.com/" aria-label="Open the full radar and traffic tracker">
          <iframe src="https://wx.ekaviates.com/" title="Live EKAviates radar and traffic tracker" loading="lazy" tabindex="-1"></iframe>
          <span class="radar-glass"></span>
        </a>
      </section>

      <section class="feature-grid" data-reveal>
        <a class="feature feature-notes" href="/notes">
          <p class="eyebrow">Training Vault</p><h2>Learn the why.</h2>
          <span>Notes and explanations built from real instruction.</span><strong>Browse aviation notes</strong>
        </a>
        <a class="feature feature-portfolio" href="/portfolio">
          <p class="eyebrow">Aviation Portfolio</p><h2>Tools built to fly.</h2>
          <span>Dashboards and utilities designed for flight training and school operations.</span><strong>View aviation projects</strong>
        </a>
      </section>
    </main>

    <footer>
      <a class="brand" href="/"><img src="/ekwx-logo.png" alt="" /><strong>EKAviates</strong></a>
      <p>Built for pilots, students, and the aviation curious.</p>
      <a href="mailto:eddiekjackson3@gmail.com">eddiekjackson3@gmail.com</a>
    </footer>
    <Analytics />
    <script>
      document.documentElement.classList.add("motion-ready");
      const revealItems = document.querySelectorAll("[data-reveal]");
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -45px" });
      revealItems.forEach((item) => observer.observe(item));

      const cloudName = "dnjzeouq5";
      const imageUrl = (photo, width) => `https://res.cloudinary.com/${cloudName}/image/upload/f_auto,q_auto,w_${width}/${photo.public_id}.${photo.format}`;
      const photoAlt = (publicId) => publicId.split("/").pop().replaceAll("_", " ").replace(/\s[a-z0-9]{6}$/i, "");

      async function refreshLatestPhotos() {
        try {
          const response = await fetch(`https://res.cloudinary.com/${cloudName}/image/list/aviation.json?fresh=${Date.now()}`, { cache: "no-store" });
          if (!response.ok) return;
          const data = await response.json();
          const photos = (data.resources ?? []).sort((a, b) => b.version - a.version).slice(0, 5);
          if (!photos.length) return;

          const heroImage = document.getElementById("hero-latest-image");
          if (heroImage) heroImage.src = imageUrl(photos[0], 1800);

          const strip = document.getElementById("home-photo-strip");
          if (!strip) return;
          const imageSlots = [...strip.querySelectorAll(".home-photo img")];
          photos.forEach((photo, index) => {
            const image = imageSlots[index];
            if (!image) return;
            image.src = imageUrl(photo, index === 0 ? 1600 : 900);
            image.alt = photoAlt(photo.public_id);
            image.loading = index === 0 ? "eager" : "lazy";
          });
        } catch {
          // Keep the build-time photos if the live feed is temporarily unavailable.
        }
      }

      refreshLatestPhotos();
    </script>
  </body>
</html>

<style>
  :root { --bg:#f7fbff; --surface:rgba(255,255,255,.82); --ink:#07111f; --text:#18324d; --muted:#637488; --line:rgba(29,95,145,.14); --blue:#1e73be; --blue-dark:#103d67; --teal:#167c8c; --gold:#b9812b; --shadow:0 28px 80px rgba(26,62,96,.14); }
  * { box-sizing:border-box; }
  html { background:var(--bg); scroll-behavior:smooth; }
  body { margin:0; min-height:100vh; color:var(--text); font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; background:#f7fbff; }
  a { color:inherit; }
  .site-header { position:sticky; top:0; z-index:40; border-bottom:1px solid var(--line); background:rgba(247,251,255,.8); backdrop-filter:blur(24px) saturate(150%); }
  .nav { max-width:1840px; min-height:78px; margin:auto; padding:10px clamp(20px,4vw,64px); display:flex; align-items:center; justify-content:space-between; gap:28px; }
  .brand { display:inline-flex; align-items:center; gap:9px; text-decoration:none; }
  .brand img { width:54px; height:54px; object-fit:contain; }
  .brand strong { color:var(--ink); font-size:.9rem; letter-spacing:.08em; text-transform:uppercase; }
  .nav-links { display:flex; align-items:center; gap:22px; }
  .nav-links a { color:var(--muted); font-size:.84rem; font-weight:700; text-decoration:none; white-space:nowrap; transition:color .18s ease; }
  .nav-links a:hover,.nav-links a[aria-current="page"] { color:var(--blue); }
  .contact-link { padding:9px 15px; border:1px solid var(--line); border-radius:999px; background:rgba(255,255,255,.58); }
  .mobile-nav { position:relative; display:none; }
  .mobile-nav summary { width:46px; height:46px; padding:12px; display:grid; align-content:center; gap:5px; list-style:none; cursor:pointer; border:1px solid var(--line); border-radius:13px; background:white; }
  .mobile-nav summary::-webkit-details-marker { display:none; }
  .mobile-nav summary span { display:block; height:2px; border-radius:9px; background:var(--text); }
  .mobile-menu { position:absolute; top:56px; right:0; width:min(340px,calc(100vw - 32px)); padding:10px; display:grid; gap:2px; border:1px solid var(--line); border-radius:16px; background:rgba(255,255,255,.98); box-shadow:var(--shadow); }
  .mobile-menu a { padding:12px 14px; border-radius:9px; color:var(--muted); font-size:.95rem; font-weight:700; text-decoration:none; }
  .mobile-menu a:hover { color:var(--blue); background:rgba(30,115,190,.07); }
  main { overflow:hidden; }
  .hero { position:relative; max-width:1840px; min-height:760px; margin:auto; padding:76px clamp(24px,4vw,72px) 92px; display:flex; align-items:center; overflow:hidden; isolation:isolate; }
  .hero::before { content:""; position:absolute; inset:0; z-index:-1; background:linear-gradient(90deg,#f7fbff 0%,rgba(247,251,255,.98) 34%,rgba(247,251,255,.84) 50%,rgba(247,251,255,.12) 77%,transparent 100%); pointer-events:none; }
  .hero-copy { position:relative; z-index:2; width:min(59%,760px); }
  .eyebrow { margin:0 0 20px; color:var(--blue); font-size:.73rem; font-weight:850; letter-spacing:.18em; text-transform:uppercase; }
  h1 { margin:0; color:var(--ink); font-size:clamp(4rem,7vw,7.6rem); line-height:.9; letter-spacing:-.07em; }
  h1 span { color:var(--blue); }
  .hero-actions { margin-top:38px; display:flex; flex-wrap:wrap; gap:12px; }
  .button { min-height:51px; padding:0 21px; display:inline-flex; align-items:center; justify-content:center; border-radius:13px; font-size:.9rem; font-weight:800; text-decoration:none; transition:transform .18s ease,box-shadow .18s ease; }
  .button:hover { transform:translateY(-2px); }
  .primary { color:white; background:linear-gradient(135deg,var(--blue),var(--blue-dark)); box-shadow:0 16px 34px rgba(30,115,190,.24); }
  .secondary { border:1px solid var(--line); background:rgba(255,255,255,.68); }
  .credentials { margin-top:42px; display:flex; flex-wrap:wrap; gap:10px; }
  .credentials span { padding:8px 11px; border:1px solid var(--line); border-radius:999px; color:var(--muted); background:rgba(255,255,255,.55); font-size:.68rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .hero-flight-image { position:absolute; inset:0 0 0 35%; z-index:-2; overflow:hidden; background:#dbe7f0; }
  .hero-flight-image::after { content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,17,31,.02),rgba(7,17,31,.12));pointer-events:none; }
  .hero-flight-image img,.image-fallback { width:100%;height:100%;display:block;object-fit:cover; }
  .image-fallback { background:linear-gradient(145deg,var(--blue-dark),var(--teal)),url("/topobackground.png") center/cover; }
  .photo-feature { max-width:1840px; margin:auto; padding:82px clamp(24px,4vw,72px) 110px; }
  .section-heading { margin-bottom:38px; display:flex; align-items:end; justify-content:space-between; gap:36px; }
  .section-heading h2 { margin:0; color:var(--ink); font-size:clamp(2.8rem,5.2vw,5.8rem); line-height:.95; letter-spacing:-.06em; }
  .section-heading > a { padding-bottom:8px; color:var(--blue); font-size:.86rem; font-weight:800; text-underline-offset:5px; }
  .photo-strip { height:650px; display:grid; grid-template-columns:1.55fr .75fr .75fr; grid-template-rows:1fr 1fr; gap:12px; }
  .home-photo { overflow:hidden; border-radius:20px; background:#dbe7f1; box-shadow:0 14px 34px rgba(26,62,96,.1); }
  .home-photo img { width:100%; height:100%; display:block; object-fit:cover; transition:transform .5s cubic-bezier(.2,.7,.2,1); }
  .home-photo:hover img { transform:scale(1.025); }
  .lead-photo { grid-row:1 / 3; }
  .home-photo:nth-child(4) { grid-column:2 / 3; }.home-photo:nth-child(5) { grid-column:3 / 4; }
  .photo-fallback { min-height:360px; display:grid; place-items:center; border-radius:22px; color:white; background:linear-gradient(135deg,var(--blue-dark),var(--teal)); font-size:1rem; font-weight:800; }
  .feature-grid { max-width:1840px; margin:auto; padding:0 clamp(24px,4vw,72px) 110px; display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .feature { min-height:450px; padding:38px; display:flex; flex-direction:column; justify-content:flex-end; overflow:hidden; border-radius:26px; color:white; text-decoration:none; box-shadow:0 22px 60px rgba(26,62,96,.14); transition:transform .2s ease; }
  .feature:hover { transform:translateY(-6px); }
  .feature-notes { background:linear-gradient(145deg,rgba(16,61,103,.94),rgba(30,115,190,.86)),url("/topobackground.png") center/cover; }
  .feature-portfolio { background:linear-gradient(145deg,#126f7c,#0b3e68); }
  .feature .eyebrow { margin-bottom:auto; color:rgba(255,255,255,.66); }.feature h2 { margin:0; font-size:clamp(2.2rem,4vw,4.4rem); line-height:.95; letter-spacing:-.055em; }.feature > span { max-width:430px; margin:18px 0 34px; color:rgba(255,255,255,.68); line-height:1.65; }.feature > strong { font-size:.84rem; }
  .radar-section { max-width:1696px; min-height:610px; margin:0 auto 110px; padding:clamp(34px,5vw,70px); display:grid;grid-template-columns:.7fr 1.3fr;align-items:center;gap:60px;overflow:hidden;border-radius:34px;color:white;background:linear-gradient(140deg,#07111f,#103d67 64%,#126779);box-shadow:0 35px 90px rgba(7,17,31,.23); }
  .radar-copy .eyebrow { color:#73dce9; }.radar-copy h2 { margin:0;font-size:clamp(2.7rem,4.7vw,5rem);line-height:.95;letter-spacing:-.06em; }.radar-copy>p:not(.eyebrow) { max-width:460px;margin:24px 0 30px;color:rgba(255,255,255,.65);line-height:1.7; }.radar-button { color:var(--ink);background:white; }.live-status { margin-top:42px;display:flex;align-items:center;gap:9px;color:rgba(255,255,255,.55);font-size:.67rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase; }.live-status i { width:8px;height:8px;border-radius:50%;background:#62e1e9;box-shadow:0 0 14px rgba(98,225,233,.9); }
  .radar-window { position:relative;height:480px;display:block;overflow:hidden;border:1px solid rgba(255,255,255,.18);border-radius:22px;background:#0b2131;box-shadow:0 24px 60px rgba(0,0,0,.3); }.radar-window::before { content:"";position:absolute;inset:12px;z-index:3;border:1px solid rgba(255,255,255,.14);border-radius:14px;pointer-events:none; }.radar-window iframe { width:100%;height:100%;border:0;pointer-events:none; }.radar-glass { position:absolute;inset:0;background:linear-gradient(145deg,rgba(7,17,31,.06),transparent 55%,rgba(7,17,31,.25));pointer-events:none; }
  .motion-ready [data-reveal] { opacity:0;transform:translateY(34px);transition:opacity .85s cubic-bezier(.2,.7,.2,1),transform .85s cubic-bezier(.2,.7,.2,1); }.motion-ready [data-reveal].is-visible { opacity:1;transform:none; }
  footer { max-width:1840px; margin:auto; padding:30px clamp(24px,4vw,72px) 44px; display:flex; align-items:center; justify-content:space-between; gap:24px; border-top:1px solid var(--line); }
  footer p,footer > a:last-child { color:var(--muted); font-size:.82rem; text-decoration:none; }
  @media (max-width:1180px) { .nav-links{display:none}.mobile-nav{display:block}.radar-section{margin-inline:22px}.hero-copy{width:min(62%,700px)} }
  @media (max-width:900px) { body{background-attachment:scroll}.hero{min-height:820px;align-items:flex-start;padding-top:66px}.hero::before{background:linear-gradient(180deg,#f7fbff 0%,rgba(247,251,255,.97) 45%,rgba(247,251,255,.82) 65%,rgba(247,251,255,.2) 100%)}.hero-copy{width:100%}.hero-flight-image{inset:26% 0 0 0}.hero-flight-image img{object-position:center 55%}.photo-strip{height:760px;grid-template-columns:1fr 1fr;grid-template-rows:1.4fr 1fr 1fr}.lead-photo{grid-column:1/3;grid-row:auto}.home-photo:nth-child(4),.home-photo:nth-child(5){grid-column:auto}.section-heading{align-items:start;flex-direction:column}.feature-grid,.radar-section{grid-template-columns:1fr} }
  @media (max-width:620px) { .nav{min-height:70px;padding:8px 16px}.brand img{width:48px;height:48px}.hero{min-height:860px;padding:52px 18px 70px;align-items:flex-start}.hero::before{background:linear-gradient(180deg,#f7fbff 0%,rgba(247,251,255,.98) 54%,rgba(247,251,255,.72) 73%,rgba(247,251,255,.08) 100%)}.hero-flight-image{inset:34% 0 0}.hero-flight-image img{object-position:52% center}h1{font-size:clamp(3.5rem,17vw,5.2rem)}.hero-actions{display:grid}.photo-feature{padding:58px 18px 76px}.photo-strip{height:auto;display:grid;grid-template-columns:1fr;grid-template-rows:none}.home-photo,.lead-photo{height:260px;grid-column:auto;grid-row:auto}.lead-photo{height:420px}.radar-section{margin:0 12px 76px;padding:48px 22px;border-radius:24px}.radar-window{height:390px}.feature-grid{padding:0 18px 76px}.feature{min-height:390px;padding:28px}footer{padding-inline:18px;align-items:flex-start;flex-direction:column} }
  @media (prefers-reduced-motion:reduce) { html{scroll-behavior:auto}*,*::before,*::after{transition-duration:.01ms!important} }
</style>
