---

---

<html lang="en">
  <head>
    <title>Contact | Eddie Jackson Aviation</title>
    <meta
      name="description"
      content="Contact Eddie Jackson for aviation questions, training resources, flight instruction, and aviation collaboration."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>

  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href="/">Eddie Jackson</a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/photos">Photos</a>
          <a href="https://publish.obsidian.md/ekaviates/Pilot+Hub/EKAviates">Notes</a>
          <a href="/flight-instruction">Instruction</a>
          <a href="/flight-line">Flight Line</a>
          <a href="/contact" aria-current="page">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="contact-layout">
        <div class="hero">
          <p class="eyebrow">Contact</p>

          <h1></h1>

          <p class="intro">
            Reach out for aviation questions, training resources, collaboration,
            or anything flight-related.
          </p>

          <section class="contact-card">
            <div>
              <span class="card-label">Email</span>
              <h2>The easiest way to reach me</h2>
              <p></p>
            </div>

            <a class="button" href="mailto:eddiekjackson3@gmail.com">
              Email Me
            </a>
          </section>
        </div>

        <aside class="image-panel" aria-label="Eddie Jackson contact information">
          <img src="/Contactinfopic.png" alt="Eddie Jackson contact information" />
        </aside>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    --bg: #05080d;
    --text: #eef6ff;
    --muted: #a8b8c8;
    --blue: #1e73be;
    --blue-dark: #0b3f73;
    --card: rgba(9, 16, 25, 0.84);
    --line: rgba(238, 246, 255, 0.14);
    --ink: #f7fbff;
    --shadow: 0 24px 70px rgba(0, 0, 0, 0.38);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    min-height: 100%;
  }

  body {
    margin: 0;
    min-height: 100vh;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: var(--text);
    background:
      radial-gradient(circle at 18% 8%, rgba(30, 115, 190, 0.34), transparent 30rem),
      linear-gradient(135deg, rgba(5, 8, 13, 0.78) 0%, rgba(7, 15, 26, 0.82) 48%, rgba(3, 7, 12, 0.9) 100%),
      url("/topobackground.png");
    background-attachment: fixed;
    background-position: center;
    background-size: cover;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(143, 199, 245, 0.08), transparent 42%);
    mask-image: linear-gradient(to bottom, black, transparent 82%);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(5, 8, 13, 0.86);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(16px);
  }

  .nav {
    max-width: 1180px;
    margin: 0 auto;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    color: var(--text);
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .nav-links a {
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    color: var(--blue);
  }

  main {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    padding: 68px 24px 88px;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 390px);
    gap: 56px;
    align-items: center;
  }

  .hero {
    max-width: 680px;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: var(--blue);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(3.4rem, 7.5vw, 6.8rem);
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  .intro {
    max-width: 590px;
    margin: 24px 0 0;
    color: #c7d5e2;
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.7;
  }

  .contact-card {
    margin-top: 38px;
    padding: 30px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    border-radius: 18px;
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(18px);
  }

  .card-label {
    display: block;
    margin-bottom: 12px;
    color: var(--blue);
    font-size: 0.76rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .contact-card h2 {
    margin: 0 0 10px;
    color: var(--ink);
    font-size: 1.45rem;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .contact-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 12px;
    background: #eef6ff;
    color: #07111f;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 800;
    box-shadow: 0 16px 32px rgba(11, 17, 23, 0.22);
    transition:
      transform 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
    background: var(--blue-dark);
    color: white;
    box-shadow: 0 16px 30px rgba(21, 91, 152, 0.3);
  }

  .image-panel {
    width: 100%;
    max-width: 390px;
    justify-self: end;
    overflow: hidden;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    backdrop-filter: blur(18px);
  }

  .image-panel img {
    display: block;
    width: 100%;
    aspect-ratio: 970 / 1194;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    main {
      padding-top: 48px;
    }

    .contact-layout {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .image-panel {
      max-width: 390px;
      justify-self: start;
    }
  }

  @media (max-width: 680px) {
    .nav {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .nav-links {
      gap: 10px 16px;
    }

    h1 {
      font-size: clamp(3rem, 17vw, 4.6rem);
    }

    .contact-card {
      padding: 26px;
      flex-direction: column;
      align-items: flex-start;
    }

    .button {
      width: 100%;
    }

    .image-panel {
      max-width: 100%;
      border-radius: 16px;
    }
  }
</style>
