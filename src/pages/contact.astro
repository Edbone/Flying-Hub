---

---

<html lang="en">
  <head>
    <title>Contact | Eddie Jackson Aviation</title>
    <meta
      name="description"
      content="Contact Eddie Jackson for aviation questions, training resources, flight instruction, and aviation collaboration."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
<link rel="icon" type="image/png" href="/favicon.png" />
  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href="/">Eddie Jackson</a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/photos">Photos</a>
          <a href="https://publish.obsidian.md/ekaviates/Pilot+Hub/EKAviates">Notes</a>
          <a href="/flight-instruction">Instruction</a>
          <a href="/contact" aria-current="page">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="contact-layout">
        <div class="hero">
          <p class="eyebrow">Contact</p>

          <h1></h1>

          <p class="intro">
            Reach out for aviation questions, training resources, collaboration,
            or anything flight-related.
          </p>

          <section class="contact-card">
            <div>
              <span class="card-label">Email</span>
              <h2>The easiest way to reach me</h2>
              <p></p>
            </div>

            <a class="button" href="mailto:eddiekjackson3@gmail.com">
              Email Me
            </a>
          </section>
        </div>

        <aside class="image-panel" aria-label="Aviation contact photo">
          <img src="/contactphoto.jpeg" alt="Eddie Jackson aviation contact photo" />
        </aside>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    --bg: #e7edf3;
    --text: #101820;
    --muted: #5e6b76;
    --blue: #2f7cc4;
    --blue-dark: #155b98;
    --yellow: #f5bf3d;
    --card: #ffffff;
    --line: rgba(16, 24, 32, 0.12);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    min-height: 100%;
  }

  body {
    margin: 0;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: var(--text);
    background:
      radial-gradient(circle at top left, rgba(47, 124, 196, 0.2), transparent 32rem),
      linear-gradient(135deg, #eef3f7 0%, #d5e1eb 45%, #8aa8c4 100%);
    min-height: 100vh;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(231, 237, 243, 0.94);
    border-bottom: 1px solid var(--line);
  }

  .nav {
    max-width: 1120px;
    margin: 0 auto;
    padding: 18px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    color: var(--text);
    font-size: 1.08rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .nav-links a {
    color: var(--muted);
    font-size: 0.94rem;
    font-weight: 650;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    color: var(--blue-dark);
  }

  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 72px 22px 90px;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 230px;
    gap: 56px;
    align-items: center;
  }

  .hero {
    max-width: 680px;
  }

  .eyebrow {
    width: fit-content;
    margin: 0 0 18px;
    padding: 8px 12px;
    border-left: 4px solid var(--yellow);
    background: rgba(255, 255, 255, 0.62);
    color: var(--blue-dark);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.94;
    letter-spacing: -0.075em;
  }

  .intro {
    max-width: 590px;
    margin: 24px 0 0;
    color: #344555;
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.7;
  }

  .contact-card {
    margin-top: 38px;
    padding: 30px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    border-radius: 18px;
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: 0 12px 30px rgba(20, 35, 50, 0.08);
  }

  .card-label {
    display: block;
    margin-bottom: 12px;
    color: var(--blue-dark);
    font-size: 0.76rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .contact-card h2 {
    margin: 0 0 10px;
    font-size: 1.45rem;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .contact-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 12px;
    background: var(--blue-dark);
    color: white;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 800;
    box-shadow: 0 12px 26px rgba(21, 91, 152, 0.24);
    transition:
      transform 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
    background: #0f4c82;
    box-shadow: 0 16px 30px rgba(21, 91, 152, 0.3);
  }

  .image-panel {
    width: 100%;
    max-width: 230px;
    justify-self: end;
    overflow: hidden;
    border-radius: 18px;
    background: #213140;
    border: 1px solid rgba(16, 24, 32, 0.12);
    box-shadow: 0 14px 34px rgba(20, 35, 50, 0.14);
  }

  .image-panel img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    main {
      padding-top: 48px;
    }

    .contact-layout {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .image-panel {
      max-width: 230px;
      justify-self: start;
    }
  }

  @media (max-width: 680px) {
    .nav {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .nav-links {
      gap: 10px 16px;
    }

    h1 {
      font-size: clamp(3rem, 17vw, 4.6rem);
    }

    .contact-card {
      padding: 26px;
      flex-direction: column;
      align-items: flex-start;
    }

    .button {
      width: 100%;
    }

    .image-panel {
      max-width: 210px;
      border-radius: 16px;
    }
  }
</style>