---
import Analytics from "@vercel/analytics/astro";

---

<html lang="en">
  <head>
    <title>Contact | Eddie Jackson Aviation</title>
    <meta
      name="description"
      content="Contact Eddie Jackson for aviation questions, training resources, flight instruction, and aviation collaboration."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>

  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href="/">Eddie Jackson</a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/photos">Photos</a>
          <a href="https://publish.obsidian.md/ekaviates/EKAviates">Notes</a>
          <a href="https://wx.ekaviates.com/">Radar & Traffic</a>
          <details class="nav-dropdown">
            <summary>Student Tools</summary>
            <div class="dropdown-menu">
              <a href="/flight-instruction#crosswind-tool">Crosswind</a>
              <a href="/flight-instruction#weight-balance-tool">Weight & Balance</a>
              <a href="/flight-instruction#density-altitude-tool">Density Altitude</a>
              <a href="https://scaniverse.com/scan/idwyj4cfuuj6r3ou" target="_blank" rel="noreferrer">3D Model IO 360</a>
            </div>
          </details>
          <a href="/flight-line">Flight Line</a>
          <a href="/contact" aria-current="page">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="contact-layout">
        <div class="hero">
          <p class="eyebrow">Contact</p>

          <h1></h1>

          <p class="intro">

          </p>

          <section class="about-card" aria-labelledby="about-heading">
            <span class="card-label">About Me</span>
            <p>
              Im a Commercial Multi-Engine Pilot, Certified Flight Instructor,
              Advanced Ground Instructor, and Instrument Ground Instructor. I
              have over 200 hours of ground instruction experience and have been
              building this resource library since I first started flying.
              Aviation has been a major part of my life for over three years now, both as a student and as an instructor. These notes are a collection of the lessons, explanations, and references that have helped me along the way, and I hope they can help other pilots build the same confidence and understanding.
            </p>
          </section>

          <section class="contact-card">
            <div>
              <span class="card-label">Email</span>
              <h2>The easiest way to reach me</h2>
              <p></p>
            </div>

            <a class="button" href="mailto:eddiekjackson3@gmail.com">
              Email Me
            </a>
          </section>
        </div>

        <aside class="image-panel" aria-label="Eddie Jackson contact information">
          <img src="/Contactinfopic.png" alt="Eddie Jackson contact information" />
        </aside>
      </section>
    </main>
    <Analytics />
  </body>
</html>

<style>
  :root {
    --bg: #05080d;
    --text: #eef6ff;
    --muted: #a8b8c8;
    --blue: #1e73be;
    --blue-dark: #0b3f73;
    --card: rgba(9, 16, 25, 0.84);
    --line: rgba(238, 246, 255, 0.14);
    --ink: #f7fbff;
    --shadow: 0 24px 70px rgba(0, 0, 0, 0.38);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    min-height: 100%;
    background-color: var(--bg);
  }

  body {
    margin: 0;
    min-height: 100vh;
    min-height: 100dvh;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: var(--text);
    background-color: var(--bg);
    background:
      radial-gradient(circle at 18% 8%, rgba(30, 115, 190, 0.34), transparent 30rem),
      linear-gradient(135deg, rgba(5, 8, 13, 0.78) 0%, rgba(7, 15, 26, 0.82) 48%, rgba(3, 7, 12, 0.9) 100%),
      url("/topobackground.png");
    background-attachment: fixed;
    background-position: center;
    background-size: cover;
    background-color: var(--bg);
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(143, 199, 245, 0.08), transparent 42%);
    mask-image: linear-gradient(to bottom, black, transparent 82%);
  }

  @media (max-width: 1180px), (hover: none) {
    body {
      background-attachment: scroll;
      background-position: center top;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(5, 8, 13, 0.86);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(16px);
  }

  .nav {
    max-width: 1360px;
    margin: 0 auto;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    color: var(--text);
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .nav-links a,
  .nav-dropdown summary {
    position: relative;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    list-style: none;
    transition: color 180ms ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"],
  .nav-dropdown summary:hover,
  .nav-dropdown summary[aria-current="page"] {
    color: var(--blue);
  }

  .nav-links > a[aria-current="page"]::after,
  .nav-dropdown summary[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -9px;
    height: 2px;
    border-radius: 999px;
    background: #00d9ff;
    box-shadow:
      0 0 8px rgba(0, 217, 255, 0.95),
      0 0 18px rgba(0, 217, 255, 0.8),
      0 0 32px rgba(0, 217, 255, 0.42);
    transform-origin: left;
    animation: navGlowIn 650ms ease-out both;
  }

  @keyframes navGlowIn {
    from {
      opacity: 0;
      transform: scaleX(0);
    }

    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown summary {
    cursor: pointer;
  }

  .nav-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    z-index: 30;
    min-width: 220px;
    padding: 8px;
    display: grid;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(5, 8, 13, 0.96);
    box-shadow: var(--shadow);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -4px);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .nav-dropdown[open] .dropdown-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .dropdown-menu a {
    padding: 10px 12px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .dropdown-menu a:hover {
    background: rgba(255, 255, 255, 0.07);
    color: var(--text);
  }

  main {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    padding: 68px 24px 88px;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 390px);
    gap: 56px;
    align-items: center;
  }

  .hero {
    max-width: 680px;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: var(--blue);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(3.4rem, 7.5vw, 6.8rem);
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  .intro {
    max-width: 590px;
    margin: 24px 0 0;
    color: #c7d5e2;
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.7;
  }

  .contact-card {
    margin-top: 38px;
    padding: 30px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    border-radius: 18px;
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(18px);
  }

  .about-card {
    margin-top: 34px;
    padding: 30px;
    border-radius: 18px;
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(18px);
  }

  .card-label {
    display: block;
    margin-bottom: 12px;
    color: var(--blue);
    font-size: 0.76rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .contact-card h2 {
    margin: 0 0 10px;
    color: var(--ink);
    font-size: 1.45rem;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .about-card h2 {
    max-width: 720px;
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.75rem, 3vw, 2.6rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
  }

  .about-card p {
    max-width: 780px;
    margin: 22px 0 0;
    color: #c7d5e2;
    font-size: 1rem;
    line-height: 1.7;
  }

  .contact-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 12px;
    background: #eef6ff;
    color: #07111f;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 800;
    box-shadow: 0 16px 32px rgba(11, 17, 23, 0.22);
    transition:
      transform 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
    background: var(--blue-dark);
    color: white;
    box-shadow: 0 16px 30px rgba(21, 91, 152, 0.3);
  }

  .image-panel {
    width: 100%;
    max-width: 390px;
    justify-self: end;
    overflow: hidden;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    backdrop-filter: blur(18px);
  }

  .image-panel img {
    display: block;
    width: 100%;
    aspect-ratio: 970 / 1194;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    main {
      padding-top: 48px;
    }

    .contact-layout {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .image-panel {
      max-width: 390px;
      justify-self: start;
    }
  }

  @media (max-width: 680px) {
    .nav {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .nav-links {
      position: relative;
      width: 100%;
      gap: 10px 16px;
    }

    .nav-dropdown {
      position: static;
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      min-width: min(220px, 100%);
      width: min(100%, 320px);
      margin-top: 0;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-4px);
    }

    .nav-dropdown[open] .dropdown-menu {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    h1 {
      font-size: clamp(3rem, 17vw, 4.6rem);
    }

    .contact-card {
      padding: 26px;
      flex-direction: column;
      align-items: flex-start;
    }

    .button {
      width: 100%;
    }

    .image-panel {
      max-width: 100%;
      border-radius: 16px;
    }
  }
</style>
