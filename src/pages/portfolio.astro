---
import Analytics from "@vercel/analytics/astro";

const projects = [
  {
    title: "Flight Line Dashboard",
    url: "https://flightlinedemo.ekaviates.com/index.html",
    description: "A fully integrated dispatch dashboard built for flight school operations, currently used at the school where I teach. Designed to centralize training notes, dispatch resources, and daily operational tools in one browser-based platform.",
    tags: ["Training Notes", "Demo Site", "Aviation"],
  },
  {
    title: "Radar & Traffic",
    url: "https://wx.ekaviates.com/",
    description: "A personal aviation coding project built to experiment with live weather, aircraft tracking, and map-based traffic displays. Designed as a fun way to explore real-time aviation data and flight-context visualization.",
    tags: ["Weather", "Traffic", "Map UI"],
  },
  {
    title: "Fleet Maintenance Tracker",
    url: "https://maintenance.aoadispatch.com/dashboard",
    description: "A maintenance tracking dashboard for our flight school fleet that parses aircraft data and generates dispatcher-facing reports to improve aircraft utilization.",
    tags: ["Maintenance", "Fleet Tracking", "Reports"],
  },
  {
    title: "Flight Line Status",
    url: "https://eddie474.github.io/Flight-Line-Status-AOA/",
    description: "A compact dispatch-style dashboard built to be viewed at the school's dispatch desk, summarizing runway, METAR, and flight condition information for quick go/no-go decision support.",
    tags: ["METAR", "Decision Logic", "Dashboard"],
  },
  {
    title: "Ground School Topic Schedule",
    url: "https://eddie474.github.io/Ground-School-Topic-Schedule/",
    description: "A dispatch-desk scheduling tool built for the school to organize ground school topics, lesson flow, and training blocks across multiple student groups.",
    tags: ["Scheduling", "Ground School", "Training Ops"],
  },
  {
    title: "AOA Attendance Calculator",
    url: "https://eddie474.github.io/AOA_Attendance_Calculator/",
    description: "A simple operations utility that quickly calculates student attendance totals for Academy of Aviation tracking workflows.",
    tags: ["Calculator", "Attendance", "Operations"],
  },
];
---

<html lang="en">
  <head>
    <title>Web-Based Aviation Tools | Eddie Jackson</title>
    <meta
      name="description"
      content="Web-based aviation tools, dashboards, and training utilities built by Eddie Jackson."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>

  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href="/" aria-label="EKAviates home">
          <img src="/ekwx-logo.png" alt="EKAviates logo" />
        </a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/photos">Photos</a>
          <a href="/portfolio" aria-current="page">Portfolio</a>
          <a href="/notes">Notes</a>
          <a href="https://wx.ekaviates.com/">Radar & Traffic</a>
          <details class="nav-dropdown">
            <summary>Student Tools</summary>
            <div class="dropdown-menu">
              <a href="/flight-instruction#crosswind-tool">Crosswind</a>
              <a href="/flight-instruction#weight-balance-tool">Weight & Balance</a>
              <a href="/flight-instruction#density-altitude-tool">Density Altitude</a>
              <a href="https://scaniverse.com/scan/idwyj4cfuuj6r3ou" target="_blank" rel="noreferrer">3D Model IO 360</a>
            </div>
          </details>
          <a href="/flight-line">Flight Line</a>
          <a href="/contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="page-heading" aria-labelledby="portfolio-heading">
        <p class="eyebrow">Aviation Coding Portfolio</p>
        <h1 id="portfolio-heading">Web-based aviation tools</h1>
        <p>
          A collection of browser-based tools, dashboards, and training utilities built for flight training and school operations.
        </p>
      </section>

      <section class="project-grid" aria-label="Coding projects">
        {projects.map((project) => (
          <article class="project-card">
            <div class="project-copy">
              <div>
                <h2>{project.title}</h2>
                <p>{project.description}</p>
              </div>

              <div class="project-meta">
                <div class="tag-list" aria-label={`${project.title} project tags`}>
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
                <a class="open-link" href={project.url}>Open Project</a>
              </div>
            </div>

            <div class="embed-frame">
              <iframe src={project.url} title={`${project.title} embedded preview`} loading="lazy"></iframe>
              <a class="embed-open" href={project.url} aria-label={`Open ${project.title}`}></a>
            </div>
          </article>
        ))}
      </section>
    </main>

    <Analytics />
  </body>
</html>

<style>
  :root {
    --bg: #f7fbff;
    --paper: rgba(255, 255, 255, 0.9);
    --text: #18324d;
    --muted: #5d7084;
    --line: rgba(29, 95, 145, 0.16);
    --blue: #1e73be;
    --blue-dark: #103d67;
    --teal: #167c8c;
    --ink: #07111f;
    --shadow: 0 24px 70px rgba(26, 62, 96, 0.14);
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    background-color: var(--bg);
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    min-height: 100dvh;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: var(--text);
    background:
      linear-gradient(180deg, rgba(247, 251, 255, 0.82) 0%, rgba(247, 251, 255, 0.96) 58%),
      linear-gradient(135deg, rgba(30, 115, 190, 0.12), rgba(22, 124, 140, 0.08) 38%, rgba(185, 129, 43, 0.08)),
      url("/topobackground.png");
    background-attachment: fixed;
    background-position: center;
    background-size: cover;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(143, 199, 245, 0.12), transparent 42%);
    mask-image: linear-gradient(to bottom, black, transparent 82%);
  }

  @media (max-width: 1180px), (hover: none) {
    body {
      background-attachment: scroll;
      background-position: center top;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(16px);
  }

  .nav {
    max-width: 1360px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: auto;
    height: clamp(56px, 5vw, 78px);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .nav-links a,
  .nav-dropdown summary {
    position: relative;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    list-style: none;
    transition: color 180ms ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"],
  .nav-dropdown summary[aria-current="page"],
  .nav-dropdown summary:hover {
    color: var(--blue);
  }

  .nav-links > a[aria-current="page"]::after,
  .nav-dropdown summary[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -9px;
    height: 2px;
    border-radius: 999px;
    background: #00d9ff;
    box-shadow:
      0 0 8px rgba(0, 217, 255, 0.95),
      0 0 18px rgba(0, 217, 255, 0.8),
      0 0 32px rgba(0, 217, 255, 0.42);
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown summary {
    cursor: pointer;
  }

  .nav-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    z-index: 30;
    min-width: 220px;
    padding: 8px;
    display: grid;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: var(--shadow);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -4px);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .nav-dropdown[open] .dropdown-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .dropdown-menu a {
    padding: 10px 12px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .dropdown-menu a:hover {
    background: rgba(30, 115, 190, 0.08);
    color: var(--text);
  }

  .nav {
    padding: 12px 24px;
    gap: 18px;
  }

  .brand img {
    height: clamp(48px, 4.5vw, 68px);
  }

  .nav-links {
    justify-content: flex-end;
    gap: 12px 18px;
  }

  .nav-links a,
  .nav-dropdown summary {
    font-size: 0.86rem;
    white-space: nowrap;
  }

  main {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    padding: 42px 24px 88px;
  }

  .page-heading {
    max-width: 760px;
    margin-bottom: 26px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--blue);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.3rem, 5vw, 4.7rem);
    line-height: 0.95;
    letter-spacing: 0;
  }

  .page-heading p:last-child {
    max-width: 680px;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.55;
  }

  .project-grid {
    display: grid;
    gap: 24px;
  }

  .project-card {
    display: grid;
    grid-template-columns: minmax(280px, 0.42fr) minmax(0, 1fr);
    min-height: 420px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: var(--shadow);
    backdrop-filter: blur(18px);
  }

  .project-copy {
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    border-right: 1px solid var(--line);
  }

  h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.45rem, 2.5vw, 2.1rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .project-copy p {
    margin: 16px 0 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .project-meta {
    display: grid;
    gap: 18px;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag-list span {
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.8);
    color: var(--text);
    font-size: 0.74rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .open-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 42px;
    padding: 0 16px;
    border-radius: 8px;
    background: var(--blue);
    color: white;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 850;
    box-shadow: 0 14px 28px rgba(30, 115, 190, 0.2);
  }

  .open-link:hover {
    background: var(--blue-dark);
  }

  .embed-frame {
    position: relative;
    min-height: 420px;
    background: #f3f8fd;
  }

  .embed-frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 420px;
    border: 0;
    background: #f3f8fd;
  }

  .embed-open {
    position: absolute;
    inset: 0;
    z-index: 2;
    cursor: pointer;
  }

  @media (max-width: 980px) {
    .nav {
      padding: 12px 18px;
      gap: 16px;
    }

    .brand img {
      height: 52px;
    }

    .nav-links {
      justify-content: flex-end;
      gap: 12px 16px;
    }

    .nav-links a,
    .nav-dropdown summary {
      font-size: 0.86rem;
    }

    .project-card {
      grid-template-columns: 1fr;
    }

    .project-copy {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 680px) {
    .nav {
      align-items: center;
      flex-direction: column;
      gap: 12px;
      padding: 10px 16px 12px;
    }

    .brand img {
      height: 52px;
    }

    .nav-links {
      position: relative;
      width: 100%;
      gap: 8px 14px;
      justify-content: center;
    }

    .nav-links a,
    .nav-dropdown summary {
      font-size: 0.84rem;
    }

    .nav-dropdown {
      position: static;
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 10px);
      left: 50%;
      min-width: min(220px, 100%);
      width: min(100%, 320px);
      margin-top: 0;
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, -4px);
    }

    .nav-dropdown[open] .dropdown-menu {
      opacity: 1;
      pointer-events: auto;
      transform: translate(-50%, 0);
    }

    main {
      padding: 30px 18px 72px;
    }

    .project-card,
    .embed-frame,
    .embed-frame iframe {
      min-height: 360px;
    }

    .project-copy {
      padding: 20px;
    }
  }
</style>
