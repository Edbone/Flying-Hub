---

---

<html lang="en">
  <head>
    <title>Flight Instruction | Eddie Jackson Aviation</title>
    <meta
      name="description"
      content="Flight instruction resources, student tools, and aviation training demos by Eddie Jackson."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>

  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href="/">EKAviates</a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/photos">Photos</a>
          <a href="https://publish.obsidian.md/ekaviates/Pilot+Hub/EKAviates">Notes</a>
          <a href="/flight-instruction" aria-current="page">Instruction</a>
          <a href="/flight-line">Flight Line</a>
          <a href="/contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="tools-section" aria-labelledby="tools-heading">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Flight Instruction</p>
            <h1 id="tools-heading">Tools</h1>
          </div>
          <p class="intro">
          </p>
        </div>

        <div class="tool-selector" role="tablist" aria-label="Training tools">
          <span class="selector-thumb" aria-hidden="true"></span>
          <button class="selector-button active" type="button" role="tab" aria-selected="true" aria-controls="crosswind-tool" data-tool="crosswind">
            Crosswind
          </button>
          <button class="selector-button" type="button" role="tab" aria-selected="false" aria-controls="weight-balance-tool" data-tool="weight-balance">
            Weight & Balance
          </button>
          <button class="selector-button" type="button" role="tab" aria-selected="false" aria-controls="density-altitude-tool" data-tool="density-altitude">
            Density Altitude
          </button>
        </div>

        <div class="tools-workspace">
          <article class="tool-card active" id="crosswind-tool" data-tool-panel="crosswind" role="tabpanel">
            <div class="tool-header">
              <span class="tool-label">Calculator</span>
              <h3>Crosswind Component</h3>
            </div>

            <form class="calculator" id="crosswind-calculator">
              <label>
                <span>Runway heading</span>
                <input
                  id="runway-heading"
                  type="number"
                  inputmode="decimal"
                  min="0"
                  max="360"
                  value="270"
                />
              </label>

              <label>
                <span>Wind direction</span>
                <input
                  id="wind-direction"
                  type="number"
                  inputmode="decimal"
                  min="0"
                  max="360"
                  value="310"
                />
              </label>

              <label>
                <span>Wind speed</span>
                <input
                  id="wind-speed"
                  type="number"
                  inputmode="decimal"
                  min="0"
                  value="18"
                />
              </label>
            </form>

            <div class="results" aria-live="polite">
              <div>
                <span class="result-label">Crosswind</span>
                <strong id="crosswind-result">12 kt</strong>
                <span id="crosswind-side">from the right</span>
              </div>

              <div>
                <span class="result-label">Headwind</span>
                <strong id="headwind-result">14 kt</strong>
                <span id="wind-kind">headwind</span>
              </div>
            </div>

            <div class="wind-visual" aria-hidden="true">
              <span class="runway-line"></span>
              <span class="wind-arrow" id="wind-arrow"></span>
            </div>
          </article>

          <article class="tool-card compact-card" id="weight-balance-tool" data-tool-panel="weight-balance" role="tabpanel" hidden>
            <div class="tool-header">
              <span class="tool-label">Calculator</span>
              <h3>Weight & Balance</h3>
            </div>

            <form class="weight-form" id="weight-balance-calculator">
              <div class="wb-row wb-heading" aria-hidden="true">
                <span>Station</span>
                <span>Weight</span>
                <span>Arm</span>
              </div>

              <label class="wb-row">
                <span>Empty</span>
                <input id="empty-weight" type="number" inputmode="decimal" value="1650" />
                <input id="empty-arm" type="number" inputmode="decimal" step="0.1" value="39.2" />
              </label>

              <label class="wb-row">
                <span>Front</span>
                <input id="front-weight" type="number" inputmode="decimal" value="340" />
                <input id="front-arm" type="number" inputmode="decimal" step="0.1" value="37.0" />
              </label>

              <label class="wb-row">
                <span>Rear</span>
                <input id="rear-weight" type="number" inputmode="decimal" value="0" />
                <input id="rear-arm" type="number" inputmode="decimal" step="0.1" value="73.0" />
              </label>

              <label class="wb-row">
                <span>Bags</span>
                <input id="baggage-weight" type="number" inputmode="decimal" value="30" />
                <input id="baggage-arm" type="number" inputmode="decimal" step="0.1" value="95.0" />
              </label>

              <label class="wb-row">
                <span>Fuel</span>
                <input id="fuel-gallons" type="number" inputmode="decimal" value="40" />
                <input id="fuel-arm" type="number" inputmode="decimal" step="0.1" value="48.0" />
              </label>

              <div class="wb-limits">
                <label>
                  <span>Max gross</span>
                  <input id="max-gross" type="number" inputmode="decimal" value="2550" />
                </label>

                <label>
                  <span>Forward CG</span>
                  <input id="forward-cg" type="number" inputmode="decimal" step="0.1" value="35.0" />
                </label>

                <label>
                  <span>Aft CG</span>
                  <input id="aft-cg" type="number" inputmode="decimal" step="0.1" value="47.3" />
                </label>
              </div>
            </form>

            <div class="results compact-results" aria-live="polite">
              <div>
                <span class="result-label">Total weight</span>
                <strong id="total-weight-result">2,260 lb</strong>
              </div>

              <div>
                <span class="result-label">Loaded CG</span>
                <strong id="loaded-cg-result">43.1 in</strong>
              </div>

              <div>
                <span class="result-label">Envelope</span>
                <strong id="balance-status-result">Within</strong>
              </div>
            </div>
          </article>

          <article class="tool-card compact-card" id="density-altitude-tool" data-tool-panel="density-altitude" role="tabpanel" hidden>
            <div class="tool-header">
              <span class="tool-label">Calculator</span>
              <h3>Density Altitude</h3>
            </div>

            <form class="calculator compact-calculator" id="density-calculator">
              <label>
                <span>Field elevation</span>
                <input
                  id="field-elevation"
                  type="number"
                  inputmode="decimal"
                  value="900"
                />
              </label>

              <label>
                <span>Altimeter</span>
                <input
                  id="altimeter"
                  type="number"
                  inputmode="decimal"
                  step="0.01"
                  value="29.92"
                />
              </label>

              <label>
                <span>OAT C</span>
                <input
                  id="outside-temp"
                  type="number"
                  inputmode="decimal"
                  value="30"
                />
              </label>
            </form>

            <div class="results compact-results" aria-live="polite">
              <div>
                <span class="result-label">Pressure altitude</span>
                <strong id="pressure-altitude-result">900 ft</strong>
              </div>

              <div>
                <span class="result-label">Density altitude</span>
                <strong id="density-altitude-result">3,098 ft</strong>
              </div>

              <div>
                <span class="result-label">ISA deviation</span>
                <strong id="isa-deviation-result">+17 C</strong>
              </div>
            </div>
          </article>

        </div>
      </section>
    </main>

    <script>
      const runwayHeading = document.getElementById("runway-heading");
      const windDirection = document.getElementById("wind-direction");
      const windSpeed = document.getElementById("wind-speed");
      const crosswindResult = document.getElementById("crosswind-result");
      const crosswindSide = document.getElementById("crosswind-side");
      const headwindResult = document.getElementById("headwind-result");
      const windKind = document.getElementById("wind-kind");
      const windArrow = document.getElementById("wind-arrow");
      const weightBalanceInputs = document.querySelectorAll("#weight-balance-calculator input");
      const totalWeightResult = document.getElementById("total-weight-result");
      const loadedCgResult = document.getElementById("loaded-cg-result");
      const balanceStatusResult = document.getElementById("balance-status-result");
      const fieldElevation = document.getElementById("field-elevation");
      const altimeter = document.getElementById("altimeter");
      const outsideTemp = document.getElementById("outside-temp");
      const pressureAltitudeResult = document.getElementById("pressure-altitude-result");
      const densityAltitudeResult = document.getElementById("density-altitude-result");
      const isaDeviationResult = document.getElementById("isa-deviation-result");
      const selectorButtons = document.querySelectorAll(".selector-button");
      const selectorThumb = document.querySelector(".selector-thumb");
      const toolPanels = document.querySelectorAll("[data-tool-panel]");
      function normalizeDegrees(value) {
        const degrees = Number(value) || 0;
        return ((degrees % 360) + 360) % 360;
      }

      function smallestAngle(from, to) {
        return ((((to - from) % 360) + 540) % 360) - 180;
      }

      function formatFeet(value) {
        return `${Math.round(value).toLocaleString()} ft`;
      }

      function getNumber(id) {
        return Number(document.getElementById(id).value) || 0;
      }

      function selectTool(toolName) {
        selectorButtons.forEach((button, index) => {
          const isActive = button.dataset.tool === toolName;
          button.classList.toggle("active", isActive);
          button.setAttribute("aria-selected", String(isActive));

          if (isActive) {
            selectorThumb.style.setProperty("--selector-index", index);
            button.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
          }
        });

        toolPanels.forEach((panel) => {
          const isActive = panel.dataset.toolPanel === toolName;
          panel.hidden = !isActive;
          panel.classList.toggle("active", isActive);
        });
      }

      function updateCrosswind() {
        const runway = normalizeDegrees(runwayHeading.value);
        const wind = normalizeDegrees(windDirection.value);
        const speed = Math.max(0, Number(windSpeed.value) || 0);
        const angle = smallestAngle(runway, wind);
        const radians = angle * (Math.PI / 180);
        const crosswind = Math.abs(speed * Math.sin(radians));
        const headwind = speed * Math.cos(radians);

        crosswindResult.textContent = `${Math.round(crosswind)} kt`;
        crosswindSide.textContent = angle > 0 ? "from the right" : angle < 0 ? "from the left" : "straight down the runway";
        headwindResult.textContent = `${Math.round(Math.abs(headwind))} kt`;
        windKind.textContent = headwind >= 0 ? "headwind" : "tailwind";
        windArrow.style.transform = `translate(-50%, -50%) rotate(${angle}deg)`;
      }

      function updateWeightBalance() {
        const stations = [
          { weight: getNumber("empty-weight"), arm: getNumber("empty-arm") },
          { weight: getNumber("front-weight"), arm: getNumber("front-arm") },
          { weight: getNumber("rear-weight"), arm: getNumber("rear-arm") },
          { weight: getNumber("baggage-weight"), arm: getNumber("baggage-arm") },
          { weight: getNumber("fuel-gallons") * 6, arm: getNumber("fuel-arm") },
        ];
        const totalWeight = stations.reduce((sum, station) => sum + station.weight, 0);
        const totalMoment = stations.reduce((sum, station) => sum + station.weight * station.arm, 0);
        const loadedCg = totalWeight > 0 ? totalMoment / totalWeight : 0;
        const maxGross = getNumber("max-gross");
        const forwardCg = getNumber("forward-cg");
        const aftCg = getNumber("aft-cg");
        const withinWeight = totalWeight <= maxGross;
        const withinCg = loadedCg >= forwardCg && loadedCg <= aftCg;

        totalWeightResult.textContent = `${Math.round(totalWeight).toLocaleString()} lb`;
        loadedCgResult.textContent = `${loadedCg.toFixed(1)} in`;
        balanceStatusResult.textContent = withinWeight && withinCg ? "Within" : "Check";
        balanceStatusResult.classList.toggle("warning", !(withinWeight && withinCg));
      }

      function updateDensityAltitude() {
        const elevation = Number(fieldElevation.value) || 0;
        const altimeterSetting = Number(altimeter.value) || 29.92;
        const oat = Number(outsideTemp.value) || 0;
        const pressureAltitude = elevation + (29.92 - altimeterSetting) * 1000;
        const isaTemp = 15 - (pressureAltitude / 1000) * 2;
        const isaDeviation = oat - isaTemp;
        const densityAltitude = pressureAltitude + 120 * isaDeviation;

        pressureAltitudeResult.textContent = formatFeet(pressureAltitude);
        densityAltitudeResult.textContent = formatFeet(densityAltitude);
        isaDeviationResult.textContent = `${isaDeviation >= 0 ? "+" : ""}${Math.round(isaDeviation)} C`;
      }

      [runwayHeading, windDirection, windSpeed].forEach((input) => {
        input.addEventListener("input", updateCrosswind);
      });

      weightBalanceInputs.forEach((input) => {
        input.addEventListener("input", updateWeightBalance);
      });

      [fieldElevation, altimeter, outsideTemp].forEach((input) => {
        input.addEventListener("input", updateDensityAltitude);
      });

      selectorButtons.forEach((button) => {
        button.addEventListener("click", () => {
          selectTool(button.dataset.tool);
        });
      });

      updateCrosswind();
      updateWeightBalance();
      updateDensityAltitude();
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #05080d;
    --paper: rgba(9, 16, 25, 0.84);
    --text: #eef6ff;
    --muted: #a8b8c8;
    --line: rgba(238, 246, 255, 0.14);
    --blue: #1e73be;
    --blue-dark: #0b3f73;
    --ink: #f7fbff;
    --shadow: 0 24px 70px rgba(0, 0, 0, 0.38);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: var(--text);
    background:
      radial-gradient(circle at 18% 8%, rgba(30, 115, 190, 0.34), transparent 30rem),
      linear-gradient(135deg, rgba(5, 8, 13, 0.78) 0%, rgba(7, 15, 26, 0.82) 48%, rgba(3, 7, 12, 0.9) 100%),
      url("/topobackground.png");
    background-attachment: fixed;
    background-position: center;
    background-size: cover;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(143, 199, 245, 0.08), transparent 42%);
    mask-image: linear-gradient(to bottom, black, transparent 82%);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(5, 8, 13, 0.86);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(16px);
  }

  .nav {
    max-width: 1180px;
    margin: 0 auto;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    color: var(--text);
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .nav-links a {
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    color: var(--blue);
  }

  main {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    padding: 42px 24px 88px;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: var(--blue);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .intro {
    max-width: 340px;
    margin: 0;
    color: #c7d5e2;
    font-size: 1rem;
    line-height: 1.55;
  }

  .tools-section {
    margin-top: 0;
  }

  .section-heading {
    margin-bottom: 28px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 24px;
  }

  .tool-selector {
    --selector-index: 0;
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-bottom: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.12);
  }

  .selector-thumb {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc((100% - 8px) / 3);
    border-radius: 14px;
    background: #eef6ff;
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.22);
    transform: translateX(calc(var(--selector-index) * 100%));
    transition: transform 220ms ease;
  }

  .selector-button {
    position: relative;
    z-index: 1;
    min-height: 58px;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.94rem;
    font-weight: 900;
    transition: color 180ms ease;
  }

  .selector-button.active {
    color: #07111f;
  }

  .selector-button:focus-visible {
    outline: 3px solid rgba(30, 115, 190, 0.65);
    outline-offset: -6px;
  }

  .tools-workspace {
    display: grid;
  }

  .tool-card {
    min-height: 590px;
    padding: 30px;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(320px, 1.15fr);
    gap: 28px;
    align-items: start;
    border-radius: 22px;
    border: 1px solid var(--line);
    background: var(--paper);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(18px);
  }

  .tool-card[hidden] {
    display: none;
  }

  .compact-card {
    grid-template-columns: minmax(0, 0.75fr) minmax(360px, 1.25fr);
  }

  .tool-header,
  .tool-placeholder {
    display: flex;
    flex-direction: column;
  }

  .tool-label {
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  h3 {
    margin: 12px 0 0;
    color: var(--ink);
    font-size: clamp(2rem, 4vw, 3.8rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .tool-placeholder {
    justify-content: center;
    text-align: center;
  }

  .tool-placeholder p {
    max-width: 28ch;
    margin: 16px auto 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .calculator {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    align-self: start;
  }

  .compact-calculator {
    grid-template-columns: 1fr;
  }

  .weight-form {
    display: grid;
    gap: 10px;
    align-self: start;
  }

  .wb-row {
    display: grid;
    grid-template-columns: minmax(64px, 0.8fr) repeat(2, minmax(0, 1fr));
    gap: 8px;
    align-items: end;
  }

  .wb-row > span {
    color: #d6e4f0;
    font-size: 0.82rem;
    font-weight: 800;
  }

  .wb-heading {
    align-items: center;
    padding-inline: 2px;
  }

  .wb-heading span {
    color: var(--muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .wb-limits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }

  label {
    display: grid;
    gap: 8px;
    color: #d6e4f0;
    font-size: 0.82rem;
    font-weight: 800;
  }

  input,
  select {
    width: 100%;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.07);
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    font-weight: 800;
    outline: none;
  }

  input[type="range"] {
    min-height: 34px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    accent-color: #eef6ff;
  }

  select {
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--muted) 50%),
      linear-gradient(135deg, var(--muted) 50%, transparent 50%);
    background-position:
      calc(100% - 18px) 52%,
      calc(100% - 12px) 52%;
    background-repeat: no-repeat;
    background-size: 6px 6px;
  }

  input:focus,
  select:focus {
    border-color: rgba(30, 115, 190, 0.74);
    box-shadow: 0 0 0 4px rgba(30, 115, 190, 0.16);
  }

  .results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    grid-column: 2;
  }

  .results div {
    padding: 18px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.06);
  }

  .compact-results {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .compact-results div {
    padding: 14px;
  }

  .result-label,
  .results span {
    display: block;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .results strong {
    display: block;
    margin: 8px 0 4px;
    color: var(--ink);
    font-size: 2.2rem;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .compact-results strong {
    font-size: 1.45rem;
  }

  .results strong.warning {
    color: #ffcf7a;
  }

  .wind-visual {
    position: relative;
    min-height: 180px;
    grid-column: 2;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid var(--line);
    background:
      linear-gradient(90deg, transparent calc(50% - 1px), rgba(238, 246, 255, 0.28) calc(50% - 1px), rgba(238, 246, 255, 0.28) calc(50% + 1px), transparent calc(50% + 1px)),
      rgba(255, 255, 255, 0.045);
  }

  .runway-line {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 92px;
    border-radius: 999px;
    background: rgba(238, 246, 255, 0.22);
    transform: translate(-50%, -50%);
  }

  .wind-arrow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 3px;
    height: 84px;
    border-radius: 999px;
    background: var(--blue);
    transform-origin: 50% 50%;
    transition: transform 180ms ease;
