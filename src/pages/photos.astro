---
import Analytics from "@vercel/analytics/astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7fbff" />
    <title>Photography | Eddie Jackson Aviation</title>
    <meta name="description" content="Aviation photography featuring aircraft, training, and flying milestones by Eddie Jackson." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/site-nav.css" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="EKAviates home"><img src="/ekwx-logo.png" alt="" /><strong>EKAviates</strong></a>
        <div class="nav-links">
          <a href="/">Home</a><a href="/photos" aria-current="page">Photos</a><a href="/portfolio">Portfolio</a><a href="/notes">Notes</a><a href="https://wx.ekaviates.com/">Radar & Traffic</a><a href="/flight-instruction">Student Tools</a><a href="/flight-line">Flight Line</a><a class="contact-link" href="/contact">Contact</a>
        </div>
        <details class="mobile-nav">
          <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
          <div class="mobile-menu"><a href="/">Home</a><a href="/photos" aria-current="page">Photos</a><a href="/portfolio">Portfolio</a><a href="/notes">Notes</a><a href="https://wx.ekaviates.com/">Radar & Traffic</a><a href="/flight-instruction">Student Tools</a><a href="/flight-line">Flight Line</a><a href="/contact">Contact</a></div>
        </details>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Flight log</p>
        <h1>Aviation,<br /><span>up close.</span></h1>
        <div class="hero-bottom">
          <p>Aircraft, training moments, and the views that make every flight worth remembering.</p>
          <div class="photo-count" aria-live="polite"><strong id="photo-count">—</strong><span>photographs</span></div>
        </div>
      </section>

      <section class="gallery-shell" aria-label="Aviation photo gallery">
        <div id="loading" class="loading-state"><span></span><p>Loading the latest photographs…</p></div>
        <div id="gallery" class="gallery"></div>
        <div id="empty-state" class="empty-state" hidden>
          <h2>The photo feed is unavailable.</h2>
          <p>Please try again shortly.</p>
          <button id="retry-button" type="button">Try again</button>
        </div>
      </section>

      <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" aria-hidden="true">
        <button id="close-button" class="close-button" type="button" aria-label="Close photo">×</button>
        <button id="previous-button" class="nav-button previous" type="button" aria-label="Previous photo">‹</button>
        <figure><img id="lightbox-image" alt="" /><figcaption id="lightbox-caption"></figcaption></figure>
        <button id="next-button" class="nav-button next" type="button" aria-label="Next photo">›</button>
      </div>
    </main>
    <Analytics />

    <script>
      const cloudName = "dnjzeouq5";
      const gallery = document.getElementById("gallery");
      const loading = document.getElementById("loading");
      const emptyState = document.getElementById("empty-state");
      const count = document.getElementById("photo-count");
      const lightbox = document.getElementById("lightbox");
      const lightboxImage = document.getElementById("lightbox-image");
      const lightboxCaption = document.getElementById("lightbox-caption");
      let photos = [];
      let activeIndex = 0;

      const titleFor = (publicId) => publicId.split("/").pop().replaceAll("_", " ").replace(/\s[a-z0-9]{6}$/i, "");
      const imageUrl = (photo, width) => `https://res.cloudinary.com/${cloudName}/image/upload/f_auto,q_auto,w_${width}/${photo.public_id}.${photo.format}`;

      function openPhoto(index) {
        activeIndex = index;
        const photo = photos[index];
        lightboxImage.src = imageUrl(photo, 2000);
        lightboxImage.alt = titleFor(photo.public_id);
        lightboxCaption.textContent = `${index + 1} / ${photos.length}`;
        lightbox.classList.add("open");
        lightbox.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        document.getElementById("close-button").focus();
      }

      function closePhoto() {
        lightbox.classList.remove("open");
        lightbox.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }

      function movePhoto(direction) {
        openPhoto((activeIndex + direction + photos.length) % photos.length);
      }

      function renderPhotos() {
        const fragment = document.createDocumentFragment();
        photos.forEach((photo, index) => {
          const article = document.createElement("article");
          article.className = `photo-card ${index % 7 === 0 ? "featured" : ""}`;
          const button = document.createElement("button");
          button.type = "button";
          button.setAttribute("aria-label", `View photo ${index + 1}`);
          const img = document.createElement("img");
          img.src = imageUrl(photo, index % 7 === 0 ? 1600 : 1000);
          img.alt = titleFor(photo.public_id);
          img.loading = index < 4 ? "eager" : "lazy";
          button.appendChild(img);
          button.addEventListener("click", () => openPhoto(index));
          article.appendChild(button);
          fragment.appendChild(article);
        });
        gallery.replaceChildren(fragment);
        count.textContent = String(photos.length).padStart(2, "0");
      }

      async function loadPhotos() {
        loading.hidden = false;
        emptyState.hidden = true;
        try {
          const response = await fetch(`https://res.cloudinary.com/${cloudName}/image/list/aviation.json?fresh=${Date.now()}`, { cache: "no-store" });
          if (!response.ok) throw new Error("Photo feed unavailable");
          const data = await response.json();
          photos = (data.resources ?? []).sort((a, b) => b.version - a.version);
          if (!photos.length) throw new Error("No photos returned");
          renderPhotos();
        } catch {
          emptyState.hidden = false;
        } finally {
          loading.hidden = true;
        }
      }

      document.getElementById("close-button").addEventListener("click", closePhoto);
      document.getElementById("previous-button").addEventListener("click", () => movePhoto(-1));
      document.getElementById("next-button").addEventListener("click", () => movePhoto(1));
      document.getElementById("retry-button").addEventListener("click", loadPhotos);
      lightbox.addEventListener("click", (event) => { if (event.target === lightbox) closePhoto(); });
      document.addEventListener("keydown", (event) => {
        if (!lightbox.classList.contains("open")) return;
        if (event.key === "Escape") closePhoto();
        if (event.key === "ArrowLeft") movePhoto(-1);
        if (event.key === "ArrowRight") movePhoto(1);
      });
      loadPhotos();
    </script>
  </body>
</html>

<style>
  :root { --bg:#f7fbff;--ink:#07111f;--text:#18324d;--muted:#637488;--line:rgba(29,95,145,.14);--blue:#1e73be;--shadow:0 28px 80px rgba(26,62,96,.14); }
  *{box-sizing:border-box}html{background:var(--bg)}body{margin:0;min-height:100vh;color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:radial-gradient(circle at 75% 5%,rgba(143,199,245,.26),transparent 28rem),linear-gradient(180deg,#f7fbff,#fff 58%,#f7fbff)}
  .site-header{position:sticky;top:0;z-index:40;border-bottom:1px solid var(--line);background:rgba(247,251,255,.8);backdrop-filter:blur(24px) saturate(150%)}.nav{max-width:1440px;min-height:78px;margin:auto;padding:10px clamp(20px,4vw,64px);display:flex;align-items:center;justify-content:space-between;gap:28px}.brand{display:inline-flex;align-items:center;gap:9px;text-decoration:none}.brand img{width:54px;height:54px;object-fit:contain}.brand strong{color:var(--ink);font-size:.9rem;letter-spacing:.08em;text-transform:uppercase}.nav-links{display:flex;align-items:center;gap:22px}.nav-links a{color:var(--muted);font-size:.84rem;font-weight:700;text-decoration:none;white-space:nowrap}.nav-links a:hover,.nav-links a[aria-current="page"]{color:var(--blue)}.contact-link{padding:9px 15px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.58)}
  .mobile-nav{position:relative;display:none}.mobile-nav summary{width:46px;height:46px;padding:12px;display:grid;align-content:center;gap:5px;list-style:none;cursor:pointer;border:1px solid var(--line);border-radius:13px;background:white}.mobile-nav summary::-webkit-details-marker{display:none}.mobile-nav summary span{height:2px;border-radius:9px;background:var(--text)}.mobile-menu{position:absolute;top:56px;right:0;width:min(340px,calc(100vw - 32px));padding:10px;display:grid;gap:2px;border:1px solid var(--line);border-radius:16px;background:white;box-shadow:var(--shadow)}.mobile-menu a{padding:12px 14px;border-radius:9px;color:var(--muted);font-size:.95rem;font-weight:700;text-decoration:none}.mobile-menu a:hover{color:var(--blue);background:rgba(30,115,190,.07)}
  .hero{max-width:1440px;margin:auto;padding:clamp(70px,9vw,130px) clamp(24px,5vw,76px) 66px}.eyebrow{margin:0 0 22px;color:var(--blue);font-size:.73rem;font-weight:850;letter-spacing:.18em;text-transform:uppercase}.hero h1{margin:0;color:var(--ink);font-size:clamp(4.5rem,10vw,10rem);line-height:.83;letter-spacing:-.075em}.hero h1 span{color:var(--blue)}.hero-bottom{margin-top:55px;display:flex;align-items:end;justify-content:space-between;gap:50px}.hero-bottom>p{max-width:590px;margin:0;color:var(--muted);font-size:1.1rem;line-height:1.72}.photo-count{display:flex;align-items:baseline;gap:10px}.photo-count strong{color:var(--ink);font-size:2.4rem;letter-spacing:-.05em}.photo-count span{color:var(--muted);font-size:.72rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .gallery-shell{max-width:1440px;margin:auto;padding:0 clamp(14px,3vw,46px) 110px}.gallery{display:grid;grid-template-columns:repeat(12,1fr);gap:12px}.photo-card{grid-column:span 4;height:430px;overflow:hidden;border-radius:18px;background:#dce7ef;box-shadow:0 14px 38px rgba(26,62,96,.08)}.photo-card.featured{grid-column:span 8;height:620px}.photo-card button{width:100%;height:100%;padding:0;border:0;background:transparent;cursor:zoom-in}.photo-card img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .55s cubic-bezier(.2,.7,.2,1)}.photo-card:hover img{transform:scale(1.025)}
  .loading-state{min-height:420px;display:grid;place-content:center;justify-items:center;gap:14px;color:var(--muted)}.loading-state[hidden]{display:none}.loading-state span{width:30px;height:30px;border:2px solid var(--line);border-top-color:var(--blue);border-radius:50%;animation:spin .8s linear infinite}.loading-state p{margin:0;font-size:.86rem}@keyframes spin{to{transform:rotate(360deg)}}.empty-state{padding:80px 24px;text-align:center;border:1px solid var(--line);border-radius:22px;background:white}.empty-state h2{margin:0;color:var(--ink);font-size:2rem}.empty-state p{color:var(--muted)}.empty-state button{margin-top:10px;padding:12px 18px;border:0;border-radius:10px;color:white;background:var(--blue);font-weight:800;cursor:pointer}
  .lightbox{position:fixed;inset:0;z-index:100;display:none;align-items:center;justify-content:center;padding:40px 90px;background:rgba(4,10,18,.94);backdrop-filter:blur(18px)}.lightbox.open{display:flex}.lightbox figure{max-width:1400px;max-height:90vh;margin:0;display:grid;justify-items:center;gap:12px}.lightbox img{max-width:100%;max-height:84vh;border-radius:12px;box-shadow:0 30px 100px rgba(0,0,0,.42)}.lightbox figcaption{color:rgba(255,255,255,.58);font-size:.72rem;font-weight:800;letter-spacing:.14em}.close-button,.nav-button{position:absolute;border:1px solid rgba(255,255,255,.14);border-radius:50%;color:white;background:rgba(255,255,255,.08);cursor:pointer}.close-button{top:22px;right:24px;width:48px;height:48px;font-size:1.8rem}.nav-button{top:50%;width:54px;height:54px;font-size:2.2rem}.previous{left:22px}.next{right:22px}
  @media(max-width:1180px){.nav-links{display:none}.mobile-nav{display:block}.photo-card{grid-column:span 6}.photo-card.featured{grid-column:span 12}}
  @media(max-width:720px){.nav{min-height:70px;padding:8px 16px}.brand img{width:48px;height:48px}.hero{padding:64px 18px 48px}.hero h1{font-size:clamp(4rem,21vw,6.5rem)}.hero-bottom{margin-top:38px;align-items:start;flex-direction:column}.gallery-shell{padding:0 10px 76px}.gallery{gap:8px}.photo-card,.photo-card.featured{grid-column:span 12;height:62vh;min-height:390px;border-radius:13px}.lightbox{padding:70px 14px}.nav-button{top:auto;bottom:16px}.previous{left:calc(50% - 66px)}.next{right:calc(50% - 66px)}}
  @media(prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
