---
import Analytics from "@vercel/analytics/astro";

const cloudName = "dnjzeouq5";

let images = [];

try {
  const res = await fetch(
    `https://res.cloudinary.com/${cloudName}/image/list/aviation.json`
  );
  const data = await res.json();

  images = (data.resources ?? []).sort((a, b) => b.version - a.version);
} catch (e) {
  images = [];
}
---

<html lang="en">
  <head>
    <title>Photo Library | Eddie Jackson Aviation</title>
    <meta
      name="description"
      content="Aviation photo library featuring training, aircraft, and flying milestones by Eddie Jackson."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>

  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href="/">EKAviates</a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/photos" aria-current="page">Photos</a>
          <a href="https://publish.obsidian.md/ekaviates/EKAviates">Notes</a>
          <a href="https://wx.ekaviates.com/">Radar & Traffic</a>
          <details class="nav-dropdown">
            <summary>Instruction</summary>
            <div class="dropdown-menu">
              <a href="/flight-instruction#crosswind-tool">Crosswind</a>
              <a href="/flight-instruction#weight-balance-tool">Weight & Balance</a>
              <a href="/flight-instruction#density-altitude-tool">Density Altitude</a>
            </div>
          </details>
          <a href="/flight-line">Flight Line</a>
          <a href="/contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Photo Library</p>
        <h1></h1>
        <p class="hero-text">
        </p>
      </section>

      {images.length > 0 ? (
        <section class="gallery" aria-label="Aviation photo gallery">
          {images.map((img) => (
            <article class="photo-card">
              <button
                class="photo-button"
                type="button"
                data-src={`https://res.cloudinary.com/${cloudName}/image/upload/f_auto,q_auto,w_1600/${img.public_id}.${img.format}`}
                data-alt={img.public_id.replaceAll("_", " ")}
                aria-label={`Open photo: ${img.public_id.replaceAll("_", " ")}`}
              >
                <img
                  src={`https://res.cloudinary.com/${cloudName}/image/upload/f_auto,q_auto,w_900/${img.public_id}.${img.format}`}
                  alt={img.public_id.replaceAll("_", " ")}
                  loading="lazy"
                />
              </button>
            </article>
          ))}
        </section>
      ) : (
        <section class="empty-state">
          <h2>No photos available</h2>
          <p>Try again later or check that your Cloudinary image list is loading correctly.</p>
        </section>
      )}

      <div id="modal" class="modal" aria-hidden="true">
        <button id="modal-close" class="modal-close" type="button" aria-label="Close image">
          ×
        </button>
        <img id="modal-img" alt="" />
      </div>
    </main>

    <Analytics />

    <script>
      const modal = document.getElementById("modal");
      const modalImg = document.getElementById("modal-img");
      const modalClose = document.getElementById("modal-close");
      const buttons = document.querySelectorAll(".photo-button");

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          modal.style.display = "flex";
          modal.setAttribute("aria-hidden", "false");
          modalImg.src = button.dataset.src;
          modalImg.alt = button.dataset.alt || "";
          document.body.style.overflow = "hidden";
        });
      });

      function closeModal() {
        modal.style.display = "none";
        modal.setAttribute("aria-hidden", "true");
        modalImg.src = "";
        document.body.style.overflow = "";
      }

      modal.addEventListener("click", (event) => {
        if (event.target === modal) {
          closeModal();
        }
      });

      modalClose.addEventListener("click", closeModal);

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && modal.style.display === "flex") {
          closeModal();
        }
      });
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #05080d;
    --text: #eef6ff;
    --muted: #a8b8c8;
    --blue: #1e73be;
    --blue-dark: #0b3f73;
    --card: rgba(9, 16, 25, 0.84);
    --line: rgba(238, 246, 255, 0.14);
    --ink: #f7fbff;
    --shadow: 0 24px 70px rgba(0, 0, 0, 0.38);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    min-height: 100%;
    background-color: var(--bg);
  }

  body {
    margin: 0;
    min-height: 100vh;
    min-height: 100dvh;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: var(--text);
    background-color: var(--bg);
    background:
      radial-gradient(circle at 18% 8%, rgba(30, 115, 190, 0.34), transparent 30rem),
      linear-gradient(135deg, rgba(5, 8, 13, 0.78) 0%, rgba(7, 15, 26, 0.82) 48%, rgba(3, 7, 12, 0.9) 100%),
      url("/topobackground.png");
    background-attachment: fixed;
    background-position: center;
    background-size: cover;
    background-color: var(--bg);
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(143, 199, 245, 0.08), transparent 42%);
    mask-image: linear-gradient(to bottom, black, transparent 82%);
  }

  @media (max-width: 1180px), (hover: none) {
    body {
      background-attachment: scroll;
      background-position: center top;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(5, 8, 13, 0.86);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(16px);
  }

  .nav {
    max-width: 1360px;
    margin: 0 auto;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    color: var(--text);
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .nav-links a,
  .nav-dropdown summary {
    position: relative;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    list-style: none;
    transition: color 180ms ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"],
  .nav-dropdown summary:hover,
  .nav-dropdown summary[aria-current="page"] {
    color: var(--blue);
  }

  .nav-links > a[aria-current="page"]::after,
  .nav-dropdown summary[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -9px;
    height: 2px;
    border-radius: 999px;
    background: #00d9ff;
    box-shadow:
      0 0 8px rgba(0, 217, 255, 0.95),
      0 0 18px rgba(0, 217, 255, 0.8),
      0 0 32px rgba(0, 217, 255, 0.42);
    transform-origin: left;
    animation: navGlowIn 650ms ease-out both;
  }

  @keyframes navGlowIn {
    from {
      opacity: 0;
      transform: scaleX(0);
    }

    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown summary {
    cursor: pointer;
  }

  .nav-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    z-index: 30;
    min-width: 220px;
    padding: 8px;
    display: grid;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(5, 8, 13, 0.96);
    box-shadow: var(--shadow);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -4px);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .nav-dropdown[open] .dropdown-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .dropdown-menu a {
    padding: 10px 12px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .dropdown-menu a:hover {
    background: rgba(255, 255, 255, 0.07);
    color: var(--text);
  }

  main {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    padding: 68px 24px 88px;
  }

  .hero {
    margin-bottom: 34px;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: var(--blue);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.4rem, 7.5vw, 6.8rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: var(--ink);
  }

  .hero-text {
    max-width: 640px;
    margin: 18px 0 0;
    color: #c7d5e2;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .gallery {
    columns: 3;
    column-gap: 18px;
    margin-top: 24px;
  }

  .photo-card {
    break-inside: avoid;
    margin-bottom: 18px;
    border-radius: 18px;
    overflow: hidden;
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(18px);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .photo-card:hover {
    transform: translateY(-4px);
    border-color: rgba(30, 115, 190, 0.34);
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.26);
  }

  .photo-button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .photo-card img {
    display: block;
    width: 100%;
    height: auto;
    vertical-align: middle;
  }

  .empty-state {
    margin-top: 28px;
    padding: 32px;
    border-radius: 18px;
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(18px);
  }

  .empty-state h2 {
    margin-top: 0;
    margin-bottom: 10px;
    font-size: 1.4rem;
  }

  .empty-state p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    padding: 24px;
    background: rgba(9, 14, 20, 0.88);
    justify-content: center;
    align-items: center;
  }

  .modal img {
    max-width: min(1200px, 92vw);
    max-height: 88vh;
    border-radius: 14px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
  }

  .modal-close {
    position: absolute;
    top: 18px;
    right: 20px;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    color: white;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    transition: background 180ms ease, transform 180ms ease;
  }

  .modal-close:hover {
    background: rgba(255, 255, 255, 0.22);
    transform: scale(1.04);
  }

  @media (max-width: 950px) {
    .gallery {
      columns: 2;
    }
  }

  @media (max-width: 1180px), (hover: none) {
    .gallery {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      columns: auto;
    }

    .photo-card {
      margin-bottom: 0;
    }
  }

  @media (max-width: 780px) {
    .nav {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .nav-links {
      position: relative;
      width: 100%;
      gap: 10px 16px;
    }

    .nav-dropdown {
      position: static;
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      min-width: min(220px, 100%);
      width: min(100%, 320px);
      margin-top: 0;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-4px);
    }

    .nav-dropdown[open] .dropdown-menu {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    main {
      padding-top: 42px;
    }

    .gallery {
      grid-template-columns: 1fr;
      columns: auto;
    }
  }

  @media (max-width: 560px) {
    .modal {
      padding: 16px;
    }

    .modal-close {
      top: 12px;
      right: 12px;
    }
  }
</style>
