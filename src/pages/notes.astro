---
import Analytics from "@vercel/analytics/astro";

const notesUrl = "https://publish.obsidian.md/ekaviates/EKAviates";
const topicRequestUrl =
  "mailto:eddiekjackson3@gmail.com?subject=Training%20Notes%20Topic%20Request";
---

<html lang="en">
  <head>
    <title>Notes | Eddie Jackson Aviation</title>
    <meta
      name="description"
      content="Browse Eddie Jackson's aviation notes and request future training topics."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>

  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href="/" aria-label="EKAviates home">
          <img src="/ekwx-logo.png" alt="EKAviates logo" />
        </a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/photos">Photos</a>
          <a href="/portfolio">Portfolio</a>
          <a href="/notes" aria-current="page">Notes</a>
          <a href="https://wx.ekaviates.com/">Radar & Traffic</a>
          <details class="nav-dropdown">
            <summary>Student Tools</summary>
            <div class="dropdown-menu">
              <a href="/flight-instruction#crosswind-tool">Crosswind</a>
              <a href="/flight-instruction#weight-balance-tool">Weight & Balance</a>
              <a href="/flight-instruction#density-altitude-tool">Density Altitude</a>
              <a href="https://scaniverse.com/scan/idwyj4cfuuj6r3ou" target="_blank" rel="noreferrer">3D Model IO 360</a>
            </div>
          </details>
          <a href="/flight-line">Flight Line</a>
          <a href="/contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="notes-shell" aria-labelledby="notes-heading">
        <div class="notes-heading">
          <div>
            <p class="eyebrow">Training Vault</p>
            <h1 id="notes-heading">Aviation Notes</h1>
          </div>
        </div>

        <div class="notes-layout">
          <section class="embed-panel" aria-label="Embedded aviation notes website">
            <iframe
              src={notesUrl}
              title="EKAviates aviation notes"
              loading="eager"
            ></iframe>
          </section>

          <aside class="request-panel" aria-labelledby="request-heading">
            <p class="eyebrow">Requests</p>
            <h2 id="request-heading">Want a topic added?</h2>
            <p>
              Send me an idea for a lesson, reference page, or aviation topic
              you would like to see in the notes.
            </p>
            <div class="request-actions">
              <a class="request-button" href={topicRequestUrl}>
                Email a Topic Request
              </a>

              <a class="open-link" href={notesUrl} target="_blank" rel="noreferrer">
                Open Full Site
              </a>
            </div>
          </aside>
        </div>
      </section>
    </main>

    <Analytics />
  </body>
</html>

<style>
  :root {
    --bg: #f7fbff;
    --paper: rgba(255, 255, 255, 0.94);
    --text: #18324d;
    --muted: #5d7084;
    --line: rgba(29, 95, 145, 0.16);
    --blue: #1e73be;
    --blue-dark: #103d67;
    --teal: #167c8c;
    --gold: #b9812b;
    --shadow: 0 24px 70px rgba(26, 62, 96, 0.14);
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    background-color: var(--bg);
  }

  body {
    margin: 0;
    min-height: 100vh;
    min-height: 100dvh;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: var(--text);
    background:
      linear-gradient(180deg, rgba(247, 251, 255, 0.82) 0%, rgba(247, 251, 255, 0.96) 58%),
      linear-gradient(135deg, rgba(30, 115, 190, 0.12), rgba(22, 124, 140, 0.08) 38%, rgba(185, 129, 43, 0.08)),
      url("/topobackground.png");
    background-attachment: fixed;
    background-position: center;
    background-size: cover;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(143, 199, 245, 0.12), transparent 42%);
    mask-image: linear-gradient(to bottom, black, transparent 82%);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(16px);
  }

  .nav {
    max-width: 1360px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: auto;
    height: clamp(48px, 4.5vw, 68px);
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px 18px;
    flex-wrap: wrap;
  }

  .nav-links a,
  .nav-dropdown summary {
    position: relative;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    list-style: none;
    transition: color 180ms ease;
    white-space: nowrap;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"],
  .nav-dropdown summary:hover {
    color: var(--blue);
  }

  .nav-links > a[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -9px;
    height: 2px;
    border-radius: 999px;
    background: #00d9ff;
    box-shadow:
      0 0 8px rgba(0, 217, 255, 0.95),
      0 0 18px rgba(0, 217, 255, 0.8),
      0 0 32px rgba(0, 217, 255, 0.42);
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown summary {
    cursor: pointer;
  }

  .nav-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    z-index: 30;
    min-width: 220px;
    padding: 8px;
    display: grid;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: var(--shadow);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -4px);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .nav-dropdown[open] .dropdown-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .dropdown-menu a {
    padding: 10px 12px;
    border-radius: 6px;
  }

  .dropdown-menu a:hover {
    background: rgba(30, 115, 190, 0.08);
    color: var(--text);
  }

  main {
    position: relative;
    width: 100%;
    padding: 28px clamp(16px, 3vw, 44px) 42px;
  }

  .notes-shell {
    width: min(100%, 1520px);
    margin: 0 auto;
  }

  .notes-heading {
    min-height: 88px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    padding-bottom: 18px;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--blue);
    font-size: 0.74rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 0;
    color: var(--blue-dark);
    font-size: clamp(2rem, 5vw, 4.6rem);
    line-height: 0.96;
  }

  h2 {
    margin-bottom: 12px;
    color: var(--blue-dark);
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    line-height: 1.08;
  }

  .open-link,
  .request-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 18px;
    border: 0;
    border-radius: 8px;
    color: white;
    background: linear-gradient(135deg, var(--blue), var(--teal));
    box-shadow: 0 14px 28px rgba(30, 115, 190, 0.22);
    font-size: 0.92rem;
    font-weight: 850;
    text-decoration: none;
    white-space: nowrap;
  }

  .notes-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: 18px;
    align-items: stretch;
  }

  .embed-panel,
  .request-panel {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    box-shadow: var(--shadow);
  }

  .embed-panel {
    min-height: min(820px, calc(100vh - 180px));
    overflow: hidden;
  }

  .embed-panel iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: min(820px, calc(100vh - 180px));
    border: 0;
    background: white;
  }

  .request-panel {
    min-height: 280px;
    padding: 24px;
    align-self: start;
  }

  .request-panel p:not(.eyebrow) {
    margin-bottom: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .request-actions {
    margin-top: 24px;
    padding-top: 18px;
    display: grid;
    gap: 12px;
    border-top: 1px solid rgba(29, 95, 145, 0.14);
  }

  .request-button,
  .open-link {
    width: 100%;
  }

  .request-panel .open-link {
    color: var(--blue-dark);
    background: rgba(30, 115, 190, 0.06);
    border: 1px solid rgba(30, 115, 190, 0.22);
    box-shadow: none;
  }

  .request-panel .open-link:hover {
    background: rgba(30, 115, 190, 0.1);
  }

  @media (max-width: 980px) {
    body {
      background-attachment: scroll;
      background-position: center top;
    }

    .nav {
      padding: 12px 18px;
      gap: 16px;
    }

    .brand img {
      height: 52px;
    }

    .nav-links {
      gap: 12px 16px;
    }

    .notes-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .notes-layout {
      grid-template-columns: 1fr;
    }

    .request-panel {
      order: -1;
      min-height: 0;
    }
  }

  @media (max-width: 640px) {
    main {
      padding: 22px 12px 34px;
    }

    .nav {
      align-items: flex-start;
      flex-direction: column;
    }

    .nav-links {
      justify-content: flex-start;
    }

    .notes-heading {
      min-height: 0;
      padding-bottom: 14px;
    }

    .open-link,
    .request-button {
      width: 100%;
    }

    .embed-panel,
    .embed-panel iframe {
      min-height: 68vh;
    }

    .request-panel {
      padding: 20px;
    }
  }
</style>
